local function setSelectedSpeed(value)
    value = math.clamp(value, Config.MinimumWalkSpeed, Config.MaximumWalkSpeed)
    value = math.floor(value / Config.WalkSpeedStep + 0.5) * Config.WalkSpeedStep
    Config.SelectedWalkSpeed = value
    updateSpeedInterface()

    if Enabled and Config.CustomSpeedEnabled then
        local _, humanoid = getCharacter()
        if humanoid then
            applyCustomSpeed(humanoid, true)
        end
    end
end

local function updateInterface()
    if #SavedCorners < 4 then
        saveCornerButton.Text = string.format("LUU GOC %d/4", #SavedCorners + 1)
        saveCornerButton.BackgroundColor3 = Color3.fromRGB(65, 135, 220)
    else
        saveCornerButton.Text = "DA LUU DU 4 GOC"
        saveCornerButton.BackgroundColor3 = Color3.fromRGB(80, 100, 110)
    end

    if Enabled then
        toggleButton.Text = "DUNG"
        toggleButton.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
    else
        toggleButton.Text = "BAT DAU"
