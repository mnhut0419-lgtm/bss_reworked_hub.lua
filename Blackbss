-- [ LOGIC 1: AUTO SWING (VUNG GẬY MƯỢT MÀ) ]
task.spawn(function()
    while task.wait(0.1) do
        if _G.Atlas_AutoFarm then
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") then
                local tool = char:FindFirstChildOfClass("Tool")
                if not tool then
                    local bpTool = player.Backpack:FindFirstChildOfClass("Tool")
                    if bpTool then 
                        char.Humanoid:EquipTool(bpTool)
                        tool = bpTool
                    end
                end
                if tool then
                    tool:Activate()
                end
            end
        end
    end
end)

-- [ LOGIC 2: NHẶT KỸ NĂNG THÔNG MINH KIỂU ATLAS ]
local currentTarget = nil
local targetStartTime = 0
local blacklistedTokens = {} -- Danh sách các token bị lỗi/biến mất

task.spawn(function()
    while task.wait(0.05) do
        local char = player.Character
        if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
            local humanoid = char.Humanoid
            local root = char.HumanoidRootPart
            
            if _G.Atlas_AutoCollect then
                humanoid.WalkSpeed = _G.Atlas_WalkSpeed
                
                -- NẾU ĐANG CÓ MỤC TIÊU
                if currentTarget and currentTarget.Parent and not blacklistedTokens[currentTarget] then
                    local dist = (currentTarget.Position - root.Position).Magnitude
                    
                    -- TIMEOUT: Nếu quá 3 giây chưa tới nơi (bị kẹt hoặc token hết hạn biến mất)
                    if tick() - targetStartTime > 3 then
                        blacklistedTokens[currentTarget] = true -- Bỏ vào danh sách đen
                        currentTarget = nil -- Hủy ghim ngay lập tức
                    elseif dist <= 4 then
                        currentTarget = nil -- Đã nhặt thành công, hủy ghim
                    else
                        humanoid:MoveTo(currentTarget.Position) -- Tiếp tục đi tới
                    end
                else
                    -- TÌM MỤC TIÊU MỚI (CHỈ TÌM TRONG BÁN KÍNH 60M)
                    local closestToken = nil
                    local shortestDist = 60 
                    
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and not blacklistedTokens[obj] then
                            local name = obj.Name:lower()
                            if name:match("token") or name:match("drop") or name:match("coin") or name == "c" then
                                local dist = (obj.Position - root.Position).Magnitude
                                if dist <= shortestDist then
                                    shortestDist = dist
                                    closestToken = obj
                                end
                            end
                        end
                    end
                    
                    -- NẾU TÌM THẤY -> GHIM LẠI VÀ BẮT ĐẦU ĐẾM THỜI GIAN
                    if closestToken then
                        currentTarget = closestToken
                        targetStartTime = tick() -- Bắt đầu bấm giờ
                        humanoid:MoveTo(closestToken.Position)
                    end
                end
            else
                -- Khi tắt Auto Nhặt, reset lại mọi thứ
                currentTarget = nil
                humanoid.WalkSpeed = 16
            end
        end
    end
end)
