-- ==============================================================================
-- ATLAS MOD FRAMEWORK BASE (BEE SWARM SIMULATOR CLONE)
-- Tối ưu hóa: Luau, OOP, Task Library, TweenService, Non-Yielding Loops
-- ==============================================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- ==========================================
-- MODULE: CẤU HÌNH (CONFIGURATION)
-- ==========================================
local Config = {
    FarmSpeed = 25, -- Tốc độ Tween (WalkSpeed mô phỏng)
    TokenRadius = 40, -- Bán kính quét vật phẩm (Studs)
    SafeDistance = 25, -- Khoảng cách né quái
    FieldVectors = {
        Sunflower = Vector3.new(100, 5, 150), -- Tọa độ ví dụ của Cánh đồng
        Mushroom = Vector3.new(-50, 5, 120)
    },
    HiveLocation = Vector3.new(0, 5, 20) -- Tọa độ tổ ong của người chơi
}

-- ==========================================
-- MODULE CHÍNH: AUTOFARM (CORE FRAMEWORK)
-- ==========================================
local AtlasFarm = {}
AtlasFarm.__index = AtlasFarm

function AtlasFarm.new()
    local self = setmetatable({}, AtlasFarm)
    self.Player = LocalPlayer
    self.Character = self.Player.Character or self.Player.CharacterAdded:Wait()
    self.RootPart = self.Character:WaitForChild("HumanoidRootPart")
    self.Humanoid = self.Character:WaitForChild("Humanoid")
    
    self.IsRunning = false
    self.CurrentField = nil
    self.State = "IDLE" -- Các trạng thái: IDLE, FARMING, CONVERTING, EVADING
    self.Cooldowns = {}
    
    return self
end

-- ==========================================
-- 1. CƠ CHẾ DI CHUYỂN & THU THẬP (MOVEMENT & FARMING)
-- ==========================================

-- Hàm di chuyển mượt mà bằng TweenService
function AtlasFarm:TweenTo(targetPosition)
    if not self.RootPart then return end
    
    local distance = (self.RootPart.Position - targetPosition).Magnitude
    local timeToTravel = distance / Config.FarmSpeed
    
    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
    local goal = {CFrame = CFrame.new(targetPosition)}
    
    local tween = TweenService:Create(self.RootPart, tweenInfo, goal)
    tween:Play()
    tween.Completed:Wait() -- Chờ Tween chạy xong mà không block luồng nếu bọc trong task
end

-- Thuật toán di chuyển Zigzag để gom phấn hoa
function AtlasFarm:FarmZigzag(fieldCenter)
    local width, length = 30, 30 -- Kích thước cánh đồng
    local step = 5
    
    for x = -width/2, width/2, step do
        for z = -length/2, length/2, step do
            if self.State ~= "FARMING" then return end -- Ngắt ngang nếu phải về tổ
            
            -- Tính toán tọa độ tiếp theo
            local target = fieldCenter + Vector3.new(x, 0, (x % (step*2) == 0) and z or -z)
            self:TweenTo(target)
        end
    end
end

-- Vòng lặp quét và thu thập Token bất đồng bộ
function AtlasFarm:StartTokenCollector()
    task.spawn(function()
        while self.IsRunning do
            if self.RootPart then
                -- Giả định game lưu các token rớt ra trong Workspace.Tokens
                local tokens = Workspace:FindFirstChild("Tokens")
                if tokens then
                    for _, token in ipairs(tokens:GetChildren()) do
                        if token:IsA("BasePart") then
                            local dist = (self.RootPart.Position - token.Position).Magnitude
                            if dist <= Config.TokenRadius then
                                -- Bắn Remote Event nhặt token tới Server (Cấu hình lại ID/Tên Remote tùy game)
                                -- ReplicatedStorage.Remotes.CollectToken:FireServer(token)
                                token:Destroy() -- Xóa cục bộ để giảm lag (Server sẽ xử lý sau)
                            end
                        end
                    end
                end
            end
            task.wait(0.1) -- Tối ưu hiệu suất, không dùng wait()
        end
    end)
end

-- ==========================================
-- 2. QUẢN LÝ KHO CHỨA (INVENTORY & RETURN BASE)
-- ==========================================

-- Kiểm tra sức chứa của Balo (Return: Tỷ lệ %)
function AtlasFarm:GetBackpackPercentage()
    -- Thay thế đường dẫn này bằng GUI hoặc Stats thật của game
    -- Ví dụ: local current = self.Player.leaderstats.Pollen.Value
    local currentPollen = 100 -- Fake data
    local maxCapacity = 100 -- Fake data
    
    return (currentPollen / maxCapacity) * 100
end

-- Logic Convert Mật Ong
function AtlasFarm:ReturnAndConvert()
    self.State = "CONVERTING"
    
    -- 1. Di chuyển về tổ ong
    self:TweenTo(Config.HiveLocation)
    task.wait(0.5)
    
    -- 2. Kích hoạt Make Honey (Gọi Remote)
    print("[Atlas] Đang chuyển hóa phấn hoa thành mật...")
    -- ReplicatedStorage.Remotes.MakeHoney:FireServer()
    
    -- 3. Vòng lặp chờ balo trống
    while self:GetBackpackPercentage() > 0 do
        task.wait(0.5)
    end
    
    print("[Atlas] Đã chuyển hóa xong, quay lại cánh đồng.")
    self.State = "FARMING"
end

-- ==========================================
-- 3. TÍNH NĂNG HỖ TRỢ C NÂNG CAO (COMBAT & BUFFS)
-- ==========================================

-- Kích hoạt vật phẩm dựa trên thời gian hồi chiêu
function AtlasFarm:UseItem(itemName, cooldownTime)
    local lastUsed = self.Cooldowns[itemName] or 0
    local currentTime = tick()
    
    if currentTime - lastUsed >= cooldownTime then
        print("[Atlas] Đang sử dụng vật phẩm: " .. itemName)
        -- ReplicatedStorage.Remotes.UseItem:FireServer(itemName)
        self.Cooldowns[itemName] = currentTime
    end
end

-- Cơ chế né tránh quái vật (Zone Checking)
function AtlasFarm:StartEvadeSystem()
    task.spawn(function()
        while self.IsRunning do
            if self.RootPart then
                -- Giả định quái nằm trong Workspace.Monsters
                local monsters = Workspace:FindFirstChild("Monsters")
                if monsters then
                    for _, mob in ipairs(monsters:GetChildren()) do
                        if mob:FindFirstChild("HumanoidRootPart") then
                            local dist = (self.RootPart.Position - mob.HumanoidRootPart.Position).Magnitude
                            if dist < Config.SafeDistance then
                                self.State = "EVADING"
                                -- Lùi lại theo hướng ngược lại với quái
                                local runDirection = (self.RootPart.Position - mob.HumanoidRootPart.Position).Unit
                                local safePos = self.RootPart.Position + (runDirection * 20)
                                self:TweenTo(safePos)
                                self.State = "FARMING"
                            end
                        end
                    end
                end
            end
            RunService.Heartbeat:Wait() -- Chạy theo từng frame, cực kỳ mượt và không delay
        end
    end)
end

-- ==========================================
-- HÀM KHỞI ĐỘNG (MAIN LOOP)
-- ==========================================
function AtlasFarm:Start()
    if self.IsRunning then return end
    self.IsRunning = true
    self.State = "FARMING"
    
    print("[Atlas] Khởi động hệ thống...")
    
    -- Bật các tiến trình chạy ngầm (Threads)
    self:StartTokenCollector()
    self:StartEvadeSystem()
    
    -- Vòng lặp Farm chính
    task.spawn(function()
        while self.IsRunning do
            if self.State == "FARMING" then
                -- 1. Kiểm tra Balo
                if self:GetBackpackPercentage() >= 100 then
                    self:ReturnAndConvert()
                else
                    -- 2. Buff kỹ năng (Ví dụ cắm Sprinkler mỗi 30 giây)
                    self:UseItem("Sprinkler", 30)
                    
                    -- 3. Farm tại cánh đồng
                    self.CurrentField = Config.FieldVectors.Sunflower
                    self:FarmZigzag(self.CurrentField)
                end
            end
            task.wait(0.1)
        end
    end)
end

function AtlasFarm:Stop()
    self.IsRunning = false
    self.State = "IDLE"
    print("[Atlas] Đã tắt hệ thống.")
end

return AtlasFarm
