-- AUTHORIZED GARDEN COLLECTOR
-- Chỉ đi bộ và chạm vật phẩm theo cơ chế bình thường của game
--==============================================================

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local Config = {
    -- Phạm vi khu vườn tính từ vị trí nhấn Bắt đầu
    FieldRadius = 85,

    -- Chỉ nhặt vật phẩm cách nhân vật không quá khoảng này
    ScanRadius = 100,

    ReachDistance = 4,
    MoveTimeout = 8,
    PickupWait = 0.5,
    FailedTargetCooldown = 8,
    PatrolMoveTime = 4,

    -- Nên để admin gắn tag "Collectible" cho vật phẩm
    CollectibleTag = "Collectible",

    AttributeNames = {
        "Collectible",
        "Pickup",
        "Token",
        "Totem",
    },

    -- Có thể thêm tên thật của vật phẩm tại đây
    NameKeywords = {
        "token",
        "totem",
        "drop",
        "coin",
        "item",
        "pickup",
        "collectible",
    },
}

local Enabled = false
local FieldCenter = nil
local CurrentTarget = nil

-- Cache vật phẩm, tránh quét toàn bộ Workspace liên tục
local Tracked = setmetatable({}, { __mode = "k" })
local BlockedUntil = setmetatable({}, { __mode = "k" })

local function containsKeyword(name)
    name = string.lower(name)

    for _, keyword in ipairs(Config.NameKeywords) do
        if string.find(name, keyword, 1, true) then
            return true
        end
    end

    return false
end

local function hasCollectibleMarker(instance)
    if CollectionService:HasTag(instance, Config.CollectibleTag) then
        return true
    end

    for _, attributeName in ipairs(Config.AttributeNames) do
        if instance:GetAttribute(attributeName) == true then
            return true
        end
    end

    return containsKeyword(instance.Name)
end

local function resolveCollectible(part)
    if hasCollectibleMarker(part) then
        return part
    end

    local ancestor = part.Parent

    -- Kiểm tra tối đa ba cấp cha: Model vật phẩm hoặc thư mục Tokens
    for _ = 1, 3 do
        if not ancestor or ancestor == workspace then
            break
        end

        if hasCollectibleMarker(ancestor) then
            if ancestor:IsA("Model") then
                return ancestor
            end

            -- Nếu là Folder như Tokens/Drops thì theo dõi Part con
            return part
        end

        ancestor = ancestor.Parent
    end

    return nil
end

local function registerInstance(instance)
    if instance:IsA("BasePart") then
        local collectible = resolveCollectible(instance)

        if collectible then
            Tracked[collectible] = true
        end
    elseif instance:IsA("Model") and hasCollectibleMarker(instance) then
        Tracked[instance] = true
    end
end

workspace.DescendantAdded:Connect(registerInstance)

workspace.DescendantRemoving:Connect(function(instance)
    Tracked[instance] = nil
    BlockedUntil[instance] = nil

    if CurrentTarget == instance then
        CurrentTarget = nil
    end
end)

CollectionService
    :GetInstanceAddedSignal(Config.CollectibleTag)
    :Connect(registerInstance)

-- Quét một lần khi khởi động, sau đó sử dụng cache
task.spawn(function()
    local descendants = workspace:GetDescendants()

    for index, instance in ipairs(descendants) do
        registerInstance(instance)

        -- Chia nhỏ công việc để tránh đứng hình trên máy yếu
        if index % 800 == 0 then
            task.wait()
        end
    end
end)

local function getCharacter()
    local character = Player.Character
    if not character then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return nil
    end

    return character, humanoid, root
end

local function getTargetPosition(target)
    if target:IsA("BasePart") then
        return target.Position
    end

    if target:IsA("Model") then
        local part = target.PrimaryPart
            or target:FindFirstChildWhichIsA("BasePart", true)

        return part and part.Position or nil
    end

    return nil
end

local function horizontalDistance(a, b)
    local difference = a - b
    return Vector2.new(difference.X, difference.Z).Magnitude
end

local function getClosestTarget(rootPosition)
    if not FieldCenter then
        return nil
    end

    local closest = nil
    local closestDistance = Config.ScanRadius
    local now = os.clock()

    for target in pairs(Tracked) do
        if not target:IsDescendantOf(workspace) then
            Tracked[target] = nil
            BlockedUntil[target] = nil
        elseif not BlockedUntil[target] or BlockedUntil[target] <= now then
            local position = getTargetPosition(target)

            if position
                and horizontalDistance(position, FieldCenter) <= Config.FieldRadius
            then
                local distance = (position - rootPosition).Magnitude

                if distance < closestDistance then
                    closestDistance = distance
                    closest = target
                end
            end
        end
    end

    return closest
end

local function walkToTarget(target, humanoid, root)
    local deadline = os.clock() + Config.MoveTimeout
    local lastGoal = nil

    while Enabled and os.clock() < deadline do
        if humanoid.Health <= 0 then
            return false
        end

        -- Vật phẩm biến mất nghĩa là server đã thu thập nó
        if not target:IsDescendantOf(workspace) then
            return true
        end

        local targetPosition = getTargetPosition(target)
        if not targetPosition then
            return false
        end

        local distance = (root.Position - targetPosition).Magnitude

        if distance <= Config.ReachDistance then
            humanoid:MoveTo(targetPosition)
            task.wait(Config.PickupWait)
            return true
        end

        if not lastGoal or (targetPosition - lastGoal).Magnitude >= 2 then
            humanoid:MoveTo(targetPosition)
            lastGoal = targetPosition
        end

        task.wait(0.15)
    end

    return false
end

local function getRandomPatrolPoint(character)
    local angle = math.random() * math.pi * 2
    local radius = math.sqrt(math.random()) * Config.FieldRadius * 0.85

    local flatPosition = FieldCenter + Vector3.new(
        math.cos(angle) * radius,
        0,
        math.sin(angle) * radius
    )

    local raycastParameters = RaycastParams.new()
    raycastParameters.FilterType = Enum.RaycastFilterType.Exclude
    raycastParameters.FilterDescendantsInstances = { character }

    local result = workspace:Raycast(
        flatPosition + Vector3.new(0, 60, 0),
        Vector3.new(0, -140, 0),
        raycastParameters
    )

    if result then
        return result.Position + Vector3.new(0, 2, 0)
    end

    return Vector3.new(flatPosition.X, FieldCenter.Y, flatPosition.Z)
end

