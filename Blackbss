local function containsKeyword(name)
    name = string.lower(name)
    for _, keyword in ipairs(Config.NameKeywords) do
        if string.find(name, keyword, 1, true) then
            return true
        end
    end
    return false
end

local function hasCollectibleMarker(instance)
    if CollectionService:HasTag(instance, Config.CollectibleTag) then
        return true
    end

    for _, attributeName in ipairs(Config.AttributeNames) do
        if instance:GetAttribute(attributeName) == true then
            return true
        end
    end

    return containsKeyword(instance.Name)
end

local function isTotemTarget(target)
    local current = target

    for _ = 1, 5 do
        if not current or current == workspace then
            break
        end

        local lowerName = string.lower(current.Name)

        if string.find(lowerName, "totem", 1, true)
            or current:GetAttribute("Totem") == true
            or CollectionService:HasTag(current, "Totem")
        then
            return true
        end

        current = current.Parent
    end

    return false
end

local function resolveCollectible(part)
    local ancestor = part.Parent

    for _ = 1, 3 do
        if not ancestor or ancestor == workspace then
            break
        end

        if hasCollectibleMarker(ancestor) then
            if ancestor:IsA("Model") then
                return ancestor
            end
            return part
        end

        ancestor = ancestor.Parent
    end

    if hasCollectibleMarker(part) then
        return part
    end

    return nil
end

local function registerInstance(instance)
    if instance:IsA("BasePart") then
        local collectible = resolveCollectible(instance)
        if collectible then
            Tracked[collectible] = true
        end
    elseif instance:IsA("Model") and hasCollectibleMarker(instance) then
        Tracked[instance] = true
    end
end

workspace.DescendantAdded:Connect(registerInstance)

workspace.DescendantRemoving:Connect(function(instance)
    Tracked[instance] = nil
    BlockedUntil[instance] = nil
    if CurrentTarget == instance then
        CurrentTarget = nil
    end
end)

CollectionService:GetInstanceAddedSignal(Config.CollectibleTag):Connect(registerInstance)

task.spawn(function()
    for index, instance in ipairs(workspace:GetDescendants()) do
        registerInstance(instance)
        if index % 800 == 0 then
            task.wait()
        end
    end
end)

local function getTargetPosition(target)
    if target:IsA("BasePart") then
        return target.Position
    end

    if target:IsA("Model") then
        local part = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
        return part and part.Position or nil
    end

    return nil
end

local function getClosestTarget(rootPosition)
    if not ZoneValid then
        return nil
    end

    local closestTarget = nil
    local closestDistance = math.huge
    local closestPriority = math.huge
    local currentTime = os.clock()

    for target in pairs(Tracked) do
        if not target:IsDescendantOf(workspace) then
            Tracked[target] = nil
            BlockedUntil[target] = nil
        elseif not BlockedUntil[target] or BlockedUntil[target] <= currentTime then
            local position = getTargetPosition(target)

            if position and isInsideZone(position, Config.TargetBoundaryTolerance) then
                local distance = (position - rootPosition).Magnitude
                local priority = 1

                if Config.PrioritizeTotems and isTotemTarget(target) then
                    priority = 0
                end

                if priority < closestPriority
                    or (priority == closestPriority and distance < closestDistance)
                then
                    closestPriority = priority
                    closestDistance = distance
                    closestTarget = target
                end
            end
        end
    end

    return closestTarget
end

local function blockTarget(target, duration)
    local untilTime = os.clock() + duration
    BlockedUntil[target] = untilTime

    if target:IsA("Model") then
        for otherTarget in pairs(Tracked) do
            if otherTarget ~= target and otherTarget:IsDescendantOf(target) then
                BlockedUntil[otherTarget] = untilTime
            end
        end
    end
end

