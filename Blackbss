local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Macroware Style - Bee Swarm Hub",
   LoadingTitle = "Đang tải hệ thống Macro...",
   LoadingSubtitle = "Fix Auto Collect",
   ConfigurationSaving = { Enabled = false }
})

local player = game.Players.LocalPlayer
local vim = game:GetService("VirtualInputManager")

_G.AutoDig = false
_G.AutoCollect = false
local currentField = "Sunflower Field"

-- ================= TAB 1: AUTO FARM =================
local FarmTab = Window:CreateTab("Auto Farm", nil)

FarmTab:CreateDropdown({
   Name = "Chọn Cánh Đồng (Field)",
   Options = {"Sunflower Field", "Dandelion Field", "Mushroom Field", "Blue Flower Field", "Clover Field", "Spider Field", "Strawberry Field", "Rose Field", "Pine Tree Forest", "Pumpkin Patch", "Pineapple Patch", "Cactus Field", "Mountain Top Field", "Pepper Patch", "Coconut Field", "Stump Field"},
   CurrentOption = {currentField},
   MultipleOptions = false,
   Flag = "FieldSelect",
   Callback = function(Option)
      currentField = Option[1]
      pcall(function()
          local char = player.Character
          local root = char and char:FindFirstChild("HumanoidRootPart")
          if root then
              local fieldPart = workspace:FindFirstChild("FlowerZones") and workspace.FlowerZones:FindFirstChild(currentField) 
                                or workspace:FindFirstChild(currentField) 
                                or workspace:FindFirstChild("Fields") and workspace.Fields:FindFirstChild(currentField)
              if fieldPart then
                  root.CFrame = fieldPart.CFrame + Vector3.new(0, 5, 0)
                  Rayfield:Notify({Title = "Dịch chuyển", Content = "Đã đến: " .. currentField, Duration = 3})
              end
          end
      end)
   end,
})

FarmTab:CreateToggle({
   Name = "Bật Auto Dig (Tự động đào/vung gậy)",
   CurrentValue = false,
   Flag = "DigToggle",
   Callback = function(Value)
       _G.AutoDig = Value
   end,
})

FarmTab:CreateToggle({
   Name = "Bật Tự Động Nhặt Token & Item (Đã Fix)",
   CurrentValue = false,
   Flag = "CollectToggle",
   Callback = function(Value)
       _G.AutoCollect = Value
   end,
})

-- ================= TAB 2: TIỆN ÍCH =================
local MiscTab = Window:CreateTab("Tiện ích", nil)

MiscTab:CreateButton({
   Name = "Kích hoạt Anti-AFK (Chống văng)",
   Callback = function()
       local vu = game:GetService("VirtualUser")
       player.Idled:Connect(function()
           vu:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
           task.wait(1)
           vu:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
       end)
       Rayfield:Notify({Title = "Thành công", Content = "Đã bật chống AFK!", Duration = 3})
   end,
})

MiscTab:CreateButton({
   Name = "Tắt Đồ Họa 3D (Siêu mượt)",
   Callback = function()
       game:GetService("RunService"):Set3dRenderingEnabled(false)
   end,
})

-- ================= CÁC VÒNG LẶP XỬ LÝ =================

-- Vòng lặp Auto Dig
task.spawn(function()
    while task.wait(0.1) do
        if _G.AutoDig then
            pcall(function()
                vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.05)
                vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
        end
    end
end)

-- Vòng lặp quét Token / Item chuẩn xác cho BSS
task.spawn(function()
    while task.wait(0.15) do
        if _G.AutoCollect then
            pcall(function()
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                    local root = char.HumanoidRootPart
                    local hum = char.Humanoid
                    local targetPos = nil
                    local minDistance = 80 -- Tăng phạm vi quét rộng hơn
                    
                    -- Tìm kiếm trong các thư mục lưu token thường gặp của BSS
                    local foldersToCheck = {workspace, workspace:FindFirstChild("Collectibles"), workspace:FindFirstChild("Tokens")}
                    for _, folder in pairs(foldersToCheck) do
                        if folder then
                            for _, obj in pairs(folder:GetChildren()) do
                                -- Nhận diện token qua tên hoặc qua cấu trúc phần thưởng rơi
                                if obj.Name == "Token" or obj:IsA("BasePart") or obj:IsA("Model") then
                                    local part = obj:IsA("Model") and obj.PrimaryPart or obj
                                    if part and part:IsA("BasePart") then
                                        local dist = (part.Position - root.Position).Magnitude
                                        if dist < minDistance then
                                            minDistance = dist
                                            targetPos = part.Position
                                        end
                                    end
                                end
                            end
                        end
                    end
                    
                    if targetPos then
                        hum:MoveTo(targetPos)
                    end
                end
            end)
        end
    end
end)
    while task.wait(0.1) do
        if _G.AutoDig then
            pcall(function()
                vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.05)
                vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
        end
    end
end)

-- Vòng lặp xử lý tự động đi bộ nhặt Token/Item rơi
task.spawn(function()
    while task.wait(0.2) do
        if _G.AutoCollect then
            pcall(function()
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                    local root = char.HumanoidRootPart
                    local hum = char.Humanoid
                    local targetPos = nil
                    local shortestDist = 55 -- Phạm vi quét tìm vật phẩm xung quanh nhân vật
                    
                    for _, v in pairs(workspace:GetDescendants()) do
                        if v:IsA("BasePart") and v:FindFirstChild("TouchInterest") and not v.Parent:FindFirstChild("Humanoid") then
                            local dist = (v.Position - root.Position).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                targetPos = v.Position
                            end
                        end
                    end
                    
                    if targetPos then 
                        hum:MoveTo(targetPos) 
                    end
                end
            end)
        end
    end
end)

Rayfield:LoadConfiguration()
