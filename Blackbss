local function calculateCenter(points)
    local total = Vector3.new(0, 0, 0)
    for _, point in ipairs(points) do
        total += point
    end
    return total / #points
end

local function sortCorners(points)
    local center = calculateCenter(points)
    local sorted = {}

    for _, point in ipairs(points) do
        table.insert(sorted, point)
    end

    table.sort(sorted, function(first, second)
        local firstAngle = math.atan2(first.Z - center.Z, first.X - center.X)
        local secondAngle = math.atan2(second.Z - center.Z, second.X - center.X)
        return firstAngle < secondAngle
    end)

    return sorted, center
end

local function calculatePolygonArea(points)
    local area = 0

    for index = 1, #points do
        local nextIndex = index % #points + 1
        local current = points[index]
        local nextPoint = points[nextIndex]
        area += current.X * nextPoint.Z - nextPoint.X * current.Z
    end

    return math.abs(area) * 0.5
end

local function distanceToSegmentXZ(point, segmentStart, segmentEnd)
    local directionX = segmentEnd.X - segmentStart.X
    local directionZ = segmentEnd.Z - segmentStart.Z
    local lengthSquared = directionX * directionX + directionZ * directionZ

    if lengthSquared <= 0.001 then
        return horizontalDistance(point, segmentStart)
    end

    local progress = (
        (point.X - segmentStart.X) * directionX
        + (point.Z - segmentStart.Z) * directionZ
    ) / lengthSquared

    progress = math.clamp(progress, 0, 1)

    local nearestX = segmentStart.X + directionX * progress
    local nearestZ = segmentStart.Z + directionZ * progress
    local differenceX = point.X - nearestX
    local differenceZ = point.Z - nearestZ

    return math.sqrt(differenceX * differenceX + differenceZ * differenceZ)
end

local function distanceToZoneBoundary(position)
    if #ZonePoints < 3 then
        return 0
    end

    local minimumDistance = math.huge

    for index = 1, #ZonePoints do
        local nextIndex = index % #ZonePoints + 1
        minimumDistance = math.min(
            minimumDistance,
            distanceToSegmentXZ(position, ZonePoints[index], ZonePoints[nextIndex])
        )
    end

    return minimumDistance
end

local function isInsideZone(position, tolerance)
    if #ZonePoints < 3 then
        return false
    end

    tolerance = tolerance or 0

    if tolerance > 0 and distanceToZoneBoundary(position) <= tolerance then
        return true
    end

    local inside = false
    local previousIndex = #ZonePoints

    for index = 1, #ZonePoints do
        local current = ZonePoints[index]
        local previous = ZonePoints[previousIndex]
        local crossesZ = (current.Z > position.Z) ~= (previous.Z > position.Z)

        if crossesZ then
            local intersectionX = (previous.X - current.X)
                * (position.Z - current.Z)
                / (previous.Z - current.Z)
                + current.X

            if position.X < intersectionX then
                inside = not inside
            end
        end

        previousIndex = index
    end

    return inside
end

local function rebuildZone()
    ZoneValid = false
    ZoneCenter = nil
    table.clear(ZonePoints)

    if #SavedCorners ~= 4 then
        return false
    end

    local sortedPoints, center = sortCorners(SavedCorners)
    for _, point in ipairs(sortedPoints) do
        table.insert(ZonePoints, point)
    end

    if calculatePolygonArea(ZonePoints) < Config.MinimumZoneArea then
        return false
    end

    ZoneCenter = center
    ZoneValid = true
    return true
end

