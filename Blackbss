-- [ FEATURE 2: AUTO COLLECT ]
CollectBtn.MouseButton1Click:Connect(function()
    autoCollect = not autoCollect
    CollectBtn.Text = autoCollect and "✅ ON" or "❌ OFF"
    CollectBtn.BackgroundColor3 = autoCollect and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(160, 40, 40)
    if autoCollect then
        StatusLabel.Text = "🔍 Đang Tìm Token..."
    end
end)

task.spawn(function()
    while _G.BSS_AutoFarm_Running do
        task.wait(0.1)
        if autoCollect then
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                local root = char.HumanoidRootPart
                local humanoid = char.Humanoid
                
                local nearestToken = nil
                local shortestDistance = collectRadius
                
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and obj:FindFirstChild("Position") then
                        local name = obj.Name:lower()
                        local parentName = obj.Parent and obj.Parent.Name:lower() or ""
                        
                        local isToken = name:match("token") or 
                                      name:match("drop") or 
                                      name:match("coin") or 
                                      name:match("pollen") or
                                      name:match("honey") or
                                      parentName:match("collectible") or
                                      collectionService:HasTag(obj, "Collectible")
                        
                        if isToken then
                            local dist = (obj.Position - root.Position).Magnitude
                            if dist <= shortestDistance then
                                shortestDistance = dist
                                nearestToken = obj
                            end
                        end
                    end
                end
                
                if nearestToken then
                    humanoid:MoveTo(nearestToken.Position)
                    StatusLabel.Text = "🎯 Đang Nhặt Token"
                else
                    StatusLabel.Text = "🔍 Tìm Token..."
                end
            end
        end
    end
end)

