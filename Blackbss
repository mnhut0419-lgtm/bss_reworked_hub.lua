-- =====================================================================
-- ATLAS CORE ARCHITECTURE - BSS 1:1 ADAPTATION
-- Framework: Rayfield | Logic: Real-time Caching & Tween Gliding
-- =====================================================================

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "🐝 Atlas Core | BSS 1:1",
   LoadingTitle = "Khởi chạy lõi Atlas...",
   LoadingSubtitle = "Đã điều chỉnh cho Fanmade Server",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
})

local _G_Atlas = {
    Farming = false,
    Collecting = false,
    GlideSpeed = 60,
    TokenRadius = 80,
    HiveCFrame = nil,
    Blacklist = {},
    CurrentTarget = nil
}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer

-- [ ANTI-AFK HỆ THỐNG ]
LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

-- [ GIAO DIỆN ĐIỀU KHIỂN ]
local FarmTab = Window:CreateTab("Auto Farm", 4483362458)
local ConfigTab = Window:CreateTab("Cài Đặt", 4483362458)

FarmTab:CreateSection("Điều khiển chính")

FarmTab:CreateToggle({
   Name = "Kích Hoạt Auto Farm (Vung Gậy)",
   CurrentValue = false,
   Flag = "AutoFarm",
   Callback = function(Value)
       _G_Atlas.Farming = Value
   end,
})

FarmTab:CreateToggle({
   Name = "Kích Hoạt Atlas Smart Collect",
   CurrentValue = false,
   Flag = "AutoCollect",
   Callback = function(Value)
       _G_Atlas.Collecting = Value
       if not Value and _G_Atlas.ActiveTween then
           _G_Atlas.ActiveTween:Cancel()
           _G_Atlas.CurrentTarget = nil
       end
   end,
})

FarmTab:CreateSection("Quản lý Tổ Ong")

FarmTab:CreateButton({
   Name = "📍 Lưu Vị Trí Tổ Hiện Tại",
   Callback = function()
       local char = LocalPlayer.Character
       if char and char:FindFirstChild("HumanoidRootPart") then
           _G_Atlas.HiveCFrame = char.HumanoidRootPart.CFrame
           Rayfield:Notify({Title = "Atlas Core", Content = "Đã lưu tọa độ tổ!", Duration = 3})
       end
   end,
})

FarmTab:CreateButton({
   Name = "🏠 Dịch Chuyển Về Tổ (Đổi Mật)",
   Callback = function()
       if _G_Atlas.HiveCFrame then
           local char = LocalPlayer.Character
           if char and char:FindFirstChild("HumanoidRootPart") then
               -- Tắt thu thập tạm thời để tránh kẹt
               local wasCollecting = _G_Atlas.Collecting
               _G_Atlas.Collecting = false
               if _G_Atlas.ActiveTween then _G_Atlas.ActiveTween:Cancel() end
               task.wait(0.2)
               
               char.HumanoidRootPart.CFrame = _G_Atlas.HiveCFrame
               task.wait(1)
               _G_Atlas.Collecting = wasCollecting
           end
       end
   end,
})

ConfigTab:CreateSlider({
   Name = "Tốc Độ Lướt (Tween Speed)",
   Range = {20, 150},
   Increment = 5,
   CurrentValue = 60,
   Flag = "Speed",
   Callback = function(Value)
       _G_Atlas.GlideSpeed = Value
   end,
})

ConfigTab:CreateSlider({
   Name = "Bán Kính Quét Token (Met)",
   Range = {30, 200},
   Increment = 10,
   CurrentValue = 80,
   Flag = "Radius",
   Callback = function(Value)
       _G_Atlas.TokenRadius = Value
   end,
})

-- [ HỆ THỐNG NOCLIP (TÀNG HÌNH VẬT LÝ) ]
RunService.Stepped:Connect(function()
    if _G_Atlas.Collecting then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- [ HỆ THỐNG AUTO FARM (SPAM CLICK) ]
task.spawn(function()
    while task.wait(0.05) do
        if _G_Atlas.Farming then
            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if not tool then
                    local bpTool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                    if bpTool then 
                        bpTool.Parent = char 
                        tool = bpTool
                    end
                end
                if tool then
                    tool:Activate()
                end
            end
        end
    end
end)

-- [ LÕI ATLAS QUÉT & LƯỚT ]
local function GetClosestToken(rootPos)
    local closest = nil
    local minDist = _G_Atlas.TokenRadius
    
    -- Cấu trúc quét diện rộng tối ưu
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not _G_Atlas.Blacklist[obj] then
            local name = string.lower(obj.Name)
            if name == "token" or name == "drop" or name == "coin" or name == "c" then
                local dist = (obj.Position - rootPos).Magnitude
                if dist <= minDist then
                    minDist = dist
                    closest = obj
                end
            end
        end
    end
    return closest
end

task.spawn(function()
    while task.wait() do -- Chạy bằng tốc độ khung hình (Siêu mượt)
        if _G_Atlas.Collecting then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local root = char.HumanoidRootPart
                
                if _G_Atlas.CurrentTarget and _G_Atlas.CurrentTarget.Parent then
                    local dist = (root.Position - _G_Atlas.CurrentTarget.Position).Magnitude
                    
                    -- Nếu đã ăn được token (khoảng cách cực gần)
                    if dist <= 3.5 then
                        if _G_Atlas.ActiveTween then _G_Atlas.ActiveTween:Cancel() end
                        _G_Atlas.CurrentTarget = nil
                        _G_Atlas.ActiveTween = nil
                    end
                else
                    -- Tìm mục tiêu mới
                    local target = GetClosestToken(root.Position)
                    
                    if target then
                        _G_Atlas.CurrentTarget = target
                        local dist = (root.Position - target.Position).Magnitude
                        local timeToTravel = dist / _G_Atlas.GlideSpeed
                        
                        local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                        -- Lướt sát mặt đất để đảm bảo chạm vào token
                        local goal = {CFrame = target.CFrame} 
                        
                        _G_Atlas.ActiveTween = TweenService:Create(root, tweenInfo, goal)
                        _G_Atlas.ActiveTween:Play()
                        
                        -- Timeout Watchdog: Kẹt quá 3 giây thì ném vào danh sách đen
                        task.spawn(function()
                            local checkTarget = target
                            task.wait(timeToTravel + 1.5)
                            if _G_Atlas.CurrentTarget == checkTarget and checkTarget.Parent then
                                _G_Atlas.Blacklist[checkTarget] = true
                                _G_Atlas.CurrentTarget = nil
                                if _G_Atlas.ActiveTween then _G_Atlas.ActiveTween:Cancel() end
                            end
                        end)
                    end
                end
            end
        end
    end
end)
