-- ==================== HÀM HỮU ÍCH ====================
local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHumanoid()
    return getCharacter():WaitForChild("Humanoid")
end

local function getRootPart()
    return getCharacter():WaitForChild("HumanoidRootPart")
end

-- Hàm di chuyển nhân vật bằng Humanoid:MoveTo (an toàn)
local function moveToPosition(position)
    local humanoid = getHumanoid()
    humanoid:MoveTo(position)
    -- Chờ đến khi đến gần
    local root = getRootPart()
    repeat
        task.wait()
    until (root.Position - position).Magnitude < 5 or not Settings.AutoFarm and not Settings.AutoCollect and not Settings.AutoTokenLink and not Settings.AutoConvert and not Settings.AutoMapAbilities and not Settings.AutoKillMonsters and not Settings.AutoDispenser and not Settings.AutoFieldBoosters
end

-- Tìm object theo tên (có thể dùng class)
local function findObject(name, parent)
    parent = parent or Workspace
    for _, obj in ipairs(parent:GetDescendants()) do
        if obj.Name == name then
            return obj
        end
    end
    return nil
end

-- Lấy vị trí cánh đồng
local function getFieldPosition(fieldName)
    -- CẦN CHỈNH: Tìm đúng object chứa cánh đồng, có thể là Model hoặc Part
    local fieldObj = findObject(fieldName)
    if fieldObj then
        if fieldObj:IsA("BasePart") then
            return fieldObj.Position
        elseif fieldObj:IsA("Model") then
            local primary = fieldObj.PrimaryPart
            if primary then
                return primary.Position
            end
        end
    end
    -- Nếu không tìm thấy, trả về vị trí mặc định (bạn nên thay bằng tọa độ chính xác)
    warn("Không tìm thấy cánh đồng:", fieldName)
    return Vector3.new(0, 20, 0)
end

-- Lấy vị trí Hive
local function getHivePosition()
    -- CẦN CHỈNH: Tìm object Hive của người chơi
    local hive = findObject("Hive")
    if hive then
        if hive:IsA("BasePart") then
            return hive.Position
        elseif hive:IsA("Model") then
            local primary = hive.PrimaryPart
            if primary then
                return primary.Position
            end
        end
    end
    warn("Không tìm thấy Hive, dùng vị trí spawn")
    local spawnLocation = LocalPlayer.RespawnLocation
    return spawnLocation and spawnLocation.Position or Vector3.new(0, 20, 0)
end

-- Kiểm tra phấn hoa đầy
local function isPollenFull()
    -- CẦN CHỈNH: Tìm giá trị phấn hoa hiện tại và tối đa trong Player
    local pollen = LocalPlayer:FindFirstChild("Pollen") or LocalPlayer:FindFirstChild("PollenCount")
    local maxPollen = LocalPlayer:FindFirstChild("MaxPollen") or LocalPlayer:FindFirstChild("PollenCapacity")
    if pollen and maxPollen then
        return pollen.Value >= maxPollen.Value
    end
    -- Nếu không có, kiểm tra qua leaderstats
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local poll = leaderstats:FindFirstChild("Pollen")
        local maxPoll = leaderstats:FindFirstChild("MaxPollen")
        if poll and maxPoll then
            return poll.Value >= maxPoll.Value
        end
    end
    return false
end

-- Hàm thu thập vật phẩm (token, ability)
local function collectItem(itemPart)
    if not itemPart or not itemPart.Parent then return end
    local root = getRootPart()
    local distance = (itemPart.Position - root.Position).Magnitude
    if distance < 10 then
        moveToPosition(itemPart.Position)
        task.wait(0.5)
        -- Chạm vào item bằng cách di chuyển root part (có thể dùng CFrame)
        root.CFrame = CFrame.new(itemPart.Position)
        task.wait(0.1)
    end
end

-- ==================== VÒNG LẶP CHỨC NĂNG ====================

-- Auto Farm Field
function autoFarmLoop()
    while Settings.AutoFarm do
        local fieldName = Settings.SelectedField
        if fieldName then
            local pos = getFieldPosition(fieldName)
            moveToPosition(pos)
            -- CẦN CHỈNH: Thêm logic thu hoạch phấn hoa (ví dụ: kích hoạt tool)
            local tool = getCharacter():FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
            end
            task.wait(1)
        else
            task.wait(1)
        end
    end
end

-- Auto Collect
function autoCollectLoop()
    while Settings.AutoCollect do
        -- CẦN CHỈNH: Tìm các vật phẩm có thể nhặt, ví dụ bằng thuộc tính "Collectible" hoặc tên
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj:GetAttribute("Collectible") == true then
                collectItem(obj)
            elseif obj:IsA("Tool") and (obj.Name:lower():find("token") or obj.Name:lower():find("ability")) then
                local handle = obj:FindFirstChild("Handle")
                if handle then
                    collectItem(handle)
                end
            end
        end
        task.wait(0.5)
    end
end

-- Auto Token Link
function autoTokenLinkLoop()
    while Settings.AutoTokenLink do
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name:lower():find("token") and obj.Name:lower():find("link") then
                local root = getRootPart()
                if (root.Position - obj.Position).Magnitude < 20 then
                    moveToPosition(obj.Position)
                    task.wait(0.5)
                    -- Nhảy để kích hoạt
                    getHumanoid():ChangeState(Enum.HumanoidStateType.Jumping)
                    task.wait(0.5)
                end
            end
        end
        task.wait(2)
    end
end

-- Auto Convert
function autoConvertLoop()
    while Settings.AutoConvert do
        if isPollenFull() then
            local hivePos = getHivePosition()
            moveToPosition(hivePos)
            task.wait(1)
            -- CẦN CHỈNH: Kích hoạt convert (có thể cần nhấn nút)
            getHumanoid():ChangeState(Enum.HumanoidStateType.Jumping)
            task.wait(2)
            -- Quay lại cánh đồng
            if Settings.SelectedField then
                local fieldPos = getFieldPosition(Settings.SelectedField)
                moveToPosition(fieldPos)
            end
        end
        task.wait(5)
    end
end

-- Auto Map Abilities
function autoMapAbilitiesLoop()
    while Settings.AutoMapAbilities do
        -- Tìm các ability tokens (Tool)
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj.Name:lower():find("ability") then
                local handle = obj:FindFirstChild("Handle")
                if handle then
                    collectItem(handle)
                    task.wait(0.3)
                end
            end
        end
        task.wait(3)
    end
end

-- Auto Kill Monsters
function autoKillMonstersLoop()
    while Settings.AutoKillMonsters do
        local monsterNames = {"Ladybug", "Rhino Beetle", "Spider", "Werewolf", "Coconut Crab"}
        for _, name in ipairs(monsterNames) do
            local monster = findObject(name)
            if monster then
                local monsterPart = monster:IsA("Model") and monster.PrimaryPart or monster
                if monsterPart then
                    moveToPosition(monsterPart.Position)
                    task.wait(0.5)
                    -- Tấn công
                    local weapon = getCharacter():FindFirstChildOfClass("Tool")
                    if weapon then
                        weapon:Activate()
                    end
                    VirtualUser:Button1Down()
                    task.wait(1)
                    VirtualUser:Button1Up()
                    task.wait(1)
                end
            end
        end
        task.wait(5)
    end
end

-- Auto Dispenser
function autoDispenserLoop()
    while Settings.AutoDispenser do
        local dispenserNames = {"Blue Dispenser", "Red Dispenser", "Treat Dispenser", "Glue Dispenser", "Coconut Dispenser"}
        for _, dispName in ipairs(dispenserNames) do
            local disp = findObject(dispName)
            if disp then
                local dispPart = disp:IsA("Model") and disp.PrimaryPart or disp
                if dispPart then
                    moveToPosition(dispPart.Position)
                    task.wait(0.5)
                    getHumanoid():ChangeState(Enum.HumanoidStateType.Jumping)
                    task.wait(0.5)
                end
            end
        end
        task.wait(60)
    end
end

-- Auto Field Boosters
function autoFieldBoostersLoop()
    while Settings.AutoFieldBoosters do
        local boosterNames = {"Mountain Top Booster", "Blue HQ Booster", "Red HQ Booster"}
        for _, bName in ipairs(boosterNames) do
            local booster = findObject(bName)
            if booster then
                local boosterPart = booster:IsA("Model") and booster.PrimaryPart or booster
                if boosterPart then
                    moveToPosition(boosterPart.Position)
                    task.wait(0.5)
                    getHumanoid():ChangeState(Enum.HumanoidStateType.Jumping)
                    task.wait(0.5)
                end
            end
        end
        task.wait(120)
    end
end

