local function getGroundPosition(position, character)
    local parameters = RaycastParams.new()
    parameters.FilterType = Enum.RaycastFilterType.Exclude
    parameters.FilterDescendantsInstances = { character, PreviewFolder }

    local result = workspace:Raycast(
        position + Vector3.new(0, 70, 0),
        Vector3.new(0, -160, 0),
        parameters
    )

    return result and (result.Position + Vector3.new(0, 2, 0)) or position
end

local function walkThroughTarget(target, humanoid, root)
    local initialPosition = getTargetPosition(target)
    if not initialPosition then
        return false
    end

    applyCustomSpeed(humanoid, true)

    local startedAt = os.clock()
    local initialSpeed = math.max(humanoid.WalkSpeed, 1)
    local initialDistance = (initialPosition - root.Position).Magnitude
    local deadline = startedAt + math.clamp(
        initialDistance / initialSpeed + Config.MoveTimeoutBuffer,
        1.5,
        Config.MaximumMoveTimeout
    )

    local previousGoal = nil
    local previousRootPosition = root.Position
    local lastMovementCheckAt = startedAt
    local lastMovementCheckPosition = root.Position

    while Enabled and os.clock() < deadline do
        applyCustomSpeed(humanoid, false)

        if humanoid.Health <= 0 then
            return false
        end

        if not isInsideZone(root.Position, Config.PlayerBoundaryTolerance) then
            return false
        end

        if not target:IsDescendantOf(workspace) then
            return true
        end

        local targetPosition = getTargetPosition(target)
        if not targetPosition
            or not isInsideZone(targetPosition, Config.TargetBoundaryTolerance)
        then
            return false
        end

        local _, passThroughDistance, reachDistance = getAdaptiveMovement(humanoid)
        local difference = targetPosition - root.Position
        local distance = difference.Magnitude
        local movementGoal = targetPosition

        if distance > 0.01 then
            local possibleGoal = targetPosition + difference.Unit * passThroughDistance
            if isInsideZone(possibleGoal, 0) then
                movementGoal = possibleGoal
        end
        end

        if not previousGoal or (movementGoal - previousGoal).Magnitude >= 0.75 then
            humanoid:MoveTo(movementGoal)
            previousGoal = movementGoal
        end

        local sweptDistance = distanceFromPointToSegment(
            targetPosition,
            previousRootPosition,
            root.Position
        )

        if distance <= reachDistance or sweptDistance <= reachDistance then
            return true
        end

        local now = os.clock()
        if now - lastMovementCheckAt >= Config.StuckCheckSeconds then
            local movedDistance = horizontalDistance(
                root.Position,
                lastMovementCheckPosition
            )

            -- Muc tieu con xa nhung nhan vat gan nhu khong di: bo muc tieu.
            if movedDistance < Config.StuckMovementThreshold then
                return false
            end

            lastMovementCheckAt = now
            lastMovementCheckPosition = root.Position
        end

        previousRootPosition = root.Position

        task.wait(Config.UpdateInterval)
    end

    return false
end

local function returnToZoneCenter(character, humanoid, root)
    if not ZoneCenter then
        return false
    end

    applyCustomSpeed(humanoid, true)

    local centerGoal = getGroundPosition(ZoneCenter, character)
    humanoid:MoveTo(centerGoal)
    local deadline = os.clock() + Config.ReturnTimeout

    while Enabled and os.clock() < deadline do
        applyCustomSpeed(humanoid, false)

        if humanoid.Health <= 0 then
            return false
        end

        if horizontalDistance(root.Position, centerGoal) <= Config.ReturnDistance then
            return true
        end

        task.wait(Config.UpdateInterval)
    end

    return false
end

local function getRandomPatrolPoint(character)
    local minimumX, maximumX = math.huge, -math.huge
    local minimumZ, maximumZ = math.huge, -math.huge

    for _, point in ipairs(ZonePoints) do
        minimumX = math.min(minimumX, point.X)
        maximumX = math.max(maximumX, point.X)
        minimumZ = math.min(minimumZ, point.Z)
        maximumZ = math.max(maximumZ, point.Z)
    end

    for _ = 1, 50 do
        local candidate = Vector3.new(
            minimumX + math.random() * (maximumX - minimumX),
            ZoneCenter.Y,
            minimumZ + math.random() * (maximumZ - minimumZ)
        )

        if isInsideZone(candidate, 0)
            and distanceToZoneBoundary(candidate) >= Config.PatrolEdgeMargin
        then
            return getGroundPosition(candidate, character)
        end
    end

    return getGroundPosition(ZoneCenter, character)
end

