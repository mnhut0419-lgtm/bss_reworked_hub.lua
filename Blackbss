-- [ CÁC BIẾN HOẠT ĐỘNG ]
local autoFarm = false
local autoCollect = false
local myHiveCFrame = nil 

FarmBtn.MouseButton1Click:Connect(function()
    autoFarm = not autoFarm
    FarmBtn.Text = autoFarm and "Farm Ngầm: BẬT" or "Farm Ngầm: TẮT"
    FarmBtn.BackgroundColor3 = autoFarm and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(45, 45, 45)
end)

CollectBtn.MouseButton1Click:Connect(function()
    autoCollect = not autoCollect
    CollectBtn.Text = autoCollect and "Đi Bộ Nhặt: BẬT" or "Đi Bộ Nhặt: TẮT"
    CollectBtn.BackgroundColor3 = autoCollect and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(45, 45, 45)
end)

SaveHiveBtn.MouseButton1Click:Connect(function()
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        myHiveCFrame = player.Character.HumanoidRootPart.CFrame
        SaveHiveBtn.Text = "Đã Lưu Tổ!"
        SaveHiveBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 30)
        task.wait(1)
        SaveHiveBtn.Text = "Lưu Vị Trí Tổ"
        SaveHiveBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    end
end)

HiveBtn.MouseButton1Click:Connect(function()
    if not myHiveCFrame then return end
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame = myHiveCFrame
    end
end)

MinimizeBtn.MouseButton1Click:Connect(function()
    Frame.Visible = false
    OpenMenuBtn.Visible = true
end)

OpenMenuBtn.MouseButton1Click:Connect(function()
    Frame.Visible = true
    OpenMenuBtn.Visible = false
end)

-- [ LOGIC 1: VUNG GẬY FARM ]
task.spawn(function()
    while _G.BSS_AutoFarm_Running do
        task.wait(0.1)
        if autoFarm then
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") then
                local tool = char:FindFirstChildOfClass("Tool")
                if not tool then
                    local bpTool = player.Backpack:FindFirstChildOfClass("Tool")
                    if bpTool then 
                        char.Humanoid:EquipTool(bpTool)
                        tool = bpTool
                    end
                end
                if tool then
                    tool:Activate()
                end
            end
        end
    end
end)

-- [ LOGIC 2: GHIM MỤC TIÊU THÔNG MINH + CHỐNG KẸT ]
local currentTarget = nil
local targetTimer = 0

task.spawn(function()
    while _G.BSS_AutoFarm_Running do
        task.wait(0.05)
        
        local char = player.Character
        if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
            local root = char.HumanoidRootPart
            local humanoid = char.Humanoid
            
            if autoCollect then
                humanoid.WalkSpeed = 40 
                
                -- KIỂM TRA MỤC TIÊU ĐANG GHIM
                if currentTarget and currentTarget.Parent then
                    targetTimer = targetTimer + 0.05
                    local distance = (currentTarget.Position - root.Position).Magnitude
                    
                    -- Nếu đã nhặt được hoặc quá 3 giây mà chưa tới được (tính là kỹ năng đã biến mất/kẹt) -> Hủy ghim
                    if distance <= 4 or targetTimer > 3 then
                        currentTarget = nil
                        targetTimer = 0
                    else
                        humanoid:MoveTo(currentTarget.Position)
                    end
                else
                    -- TÌM MỤC TIÊU MỚI
                    currentTarget = nil
                    targetTimer = 0
                    local shortestDistance = 60
                    local tempTarget = nil
                    
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") then
                            local name = obj.Name:lower()
                            if name:match("token") or name:match("drop") or name:match("coin") or name == "c" then
                                local dist = (obj.Position - root.Position).Magnitude
                                if dist <= shortestDistance then
                                    shortestDistance = dist
                                    tempTarget = obj
                                end
                            end
                        end
                    end
                    
                    if tempTarget then
                        currentTarget = tempTarget
                        targetTimer = 0 -- Reset bộ đếm thời gian khi bắt đầu ghim mới
                        humanoid:MoveTo(currentTarget.Position)
                    end
                end
            else
                currentTarget = nil
                targetTimer = 0
                humanoid.WalkSpeed = 16
            end
        end
    end
end)
