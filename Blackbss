local draggingSpeed = false
local activeTouch = nil

local function setSpeedFromScreenX(screenX)
    if speedTrack.AbsoluteSize.X <= 0 then
        return
    end

    local ratio = math.clamp(
        (screenX - speedTrack.AbsolutePosition.X) / speedTrack.AbsoluteSize.X,
        0,
        1
    )

    local value = Config.MinimumWalkSpeed
        + ratio * (Config.MaximumWalkSpeed - Config.MinimumWalkSpeed)

    setSelectedSpeed(value)
end

speedInput.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
    then
        draggingSpeed = true

        if input.UserInputType == Enum.UserInputType.Touch then
            activeTouch = input
        end

        setSpeedFromScreenX(input.Position.X)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not draggingSpeed then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input == activeTouch
    then
        setSpeedFromScreenX(input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input == activeTouch
    then
        draggingSpeed = false
        activeTouch = nil
    end
end)

