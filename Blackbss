local ConfigAttributePrefix = "AtlasGarden_"

local function saveSessionConfig()
    Player:SetAttribute(ConfigAttributePrefix .. "Version", 1)
    Player:SetAttribute(ConfigAttributePrefix .. "WalkSpeed", Config.SelectedWalkSpeed)
    Player:SetAttribute(ConfigAttributePrefix .. "CustomSpeed", Config.CustomSpeedEnabled)
    Player:SetAttribute(ConfigAttributePrefix .. "PrioritizeTotems", Config.PrioritizeTotems)
    Player:SetAttribute(ConfigAttributePrefix .. "AutoSwing", Config.AutoSwingEnabled)
    Player:SetAttribute(ConfigAttributePrefix .. "ShowPreview", Config.ShowZonePreview)

    for index = 1, 4 do
        Player:SetAttribute(
            ConfigAttributePrefix .. "Corner" .. index,
            SavedCorners[index]
        )
    end

    return #SavedCorners == 4 and ZoneValid
end

local function loadSessionConfig()
    if Player:GetAttribute(ConfigAttributePrefix .. "Version") ~= 1 then
        return false, false
    end

    local savedSpeed = Player:GetAttribute(ConfigAttributePrefix .. "WalkSpeed")
    local savedCustomSpeed = Player:GetAttribute(ConfigAttributePrefix .. "CustomSpeed")
    local savedPriority = Player:GetAttribute(ConfigAttributePrefix .. "PrioritizeTotems")
    local savedAutoSwing = Player:GetAttribute(ConfigAttributePrefix .. "AutoSwing")
    local savedPreview = Player:GetAttribute(ConfigAttributePrefix .. "ShowPreview")

    if typeof(savedSpeed) == "number" then
        Config.SelectedWalkSpeed = math.clamp(
            savedSpeed,
            Config.MinimumWalkSpeed,
            Config.MaximumWalkSpeed
        )
    end

    if typeof(savedCustomSpeed) == "boolean" then
        Config.CustomSpeedEnabled = savedCustomSpeed
    end

    if typeof(savedPriority) == "boolean" then
        Config.PrioritizeTotems = savedPriority
    end

    if typeof(savedAutoSwing) == "boolean" then
        Config.AutoSwingEnabled = savedAutoSwing
    end

    if typeof(savedPreview) == "boolean" then
        Config.ShowZonePreview = savedPreview
    end

    local loadedCorners = {}

    for index = 1, 4 do
        local corner = Player:GetAttribute(ConfigAttributePrefix .. "Corner" .. index)

        if typeof(corner) ~= "Vector3" then
            table.clear(loadedCorners)
            break
        end

        table.insert(loadedCorners, corner)
    end

    local loadedZone = #loadedCorners == 4

    if loadedZone then
        table.clear(SavedCorners)

        for _, corner in ipairs(loadedCorners) do
            table.insert(SavedCorners, corner)
        end

        loadedZone = rebuildZone()
    end

    refreshZonePreview()
    return true, loadedZone
end

local function updateSpeedInterface()
    local range = Config.MaximumWalkSpeed - Config.MinimumWalkSpeed
    local ratio = (Config.SelectedWalkSpeed - Config.MinimumWalkSpeed) / range
    ratio = math.clamp(ratio, 0, 1)

    speedFill.Size = UDim2.fromScale(ratio, 1)
    speedKnob.Position = UDim2.fromScale(ratio, 0.5)
    speedLabel.Text = string.format("TOC DO NHAN VAT: %d", Config.SelectedWalkSpeed)

    if Config.CustomSpeedEnabled then
        speedModeButton.Text = "TOC DO RIENG: BAT"
        speedModeButton.BackgroundColor3 = Color3.fromRGB(45, 155, 90)
    else
        speedModeButton.Text = "TOC DO RIENG: TAT - DUNG BUFF GAME"
        speedModeButton.BackgroundColor3 = Color3.fromRGB(80, 82, 92)
    end
end

