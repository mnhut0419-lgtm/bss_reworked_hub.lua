status.Text = "Đứng giữa khu vườn rồi bấm Bắt đầu"
status.TextColor3 = Color3.fromRGB(210, 210, 215)
status.Font = Enum.Font.Gotham
status.TextSize = 12
status.TextWrapped = true
status.Parent = frame

local function stopMoving()
    local _, humanoid, root = getCharacter()

    if humanoid and root then
        humanoid:MoveTo(root.Position)
    end
end

local function updateButton()
    if Enabled then
        toggleButton.Text = "DỪNG"
        toggleButton.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
    else
        toggleButton.Text = "BẮT ĐẦU"
        toggleButton.BackgroundColor3 = Color3.fromRGB(45, 170, 95)
    end
end

toggleButton.Activated:Connect(function()
    if Enabled then
        Enabled = false
        CurrentTarget = nil
        status.Text = "Đã dừng"
        stopMoving()
    else
        local _, _, root = getCharacter()

        if not root then
            status.Text = "Không tìm thấy nhân vật"
            return
        end

        -- Vị trí hiện tại trở thành tâm khu vườn
        FieldCenter = root.Position
        Enabled = true
        status.Text = "Đang tìm vật phẩm..."
    end

    updateButton()
end)

--==============================================================
-- VÒNG LẶP THU THẬP VÀ ĐI TUẦN TRA
--==============================================================

task.spawn(function()
    while gui.Parent do
        if not Enabled then
            task.wait(0.25)
        else
            local character, humanoid, root = getCharacter()

            if not character then
                status.Text = "Đang chờ nhân vật..."
                task.wait(0.5)
            else
                local target = getClosestTarget(root.Position)

                if target then
                    CurrentTarget = target
                    status.Text = "Đang tới: " .. target.Name

                    local reached = walkToTarget(target, humanoid, root)

                    if target:IsDescendantOf(workspace) then
                        BlockedUntil[target] = os.clock()
                            + (reached and 2 or Config.FailedTargetCooldown)
                    end

                    CurrentTarget = nil
                else
                    status.Text = "Không có vật phẩm — đang đi tuần tra"

                    local patrolPoint = getRandomPatrolPoint(character)
                    humanoid:MoveTo(patrolPoint)

                    local deadline = os.clock() + Config.PatrolMoveTime

                    while Enabled and os.clock() < deadline do
                        if humanoid.Health <= 0 then
                            break
                        end

                        -- Ngừng tuần tra ngay khi xuất hiện vật phẩm
                        if getClosestTarget(root.Position) then
                            break
                        end

                        if horizontalDistance(root.Position, patrolPoint) <= 4 then
                            break
                        end

                        task.wait(0.25)
                    end
                end
            end
        end
    end
end)

Player.CharacterRemoving:Connect(function()
    if Enabled then
        Enabled = false
        CurrentTarget = nil
        status.Text = "Nhân vật hồi sinh — hãy bật lại"
        updateButton()
    end
end)
