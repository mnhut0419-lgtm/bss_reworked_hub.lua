task.spawn(function()
    while gui.Parent do
        if not Enabled then
            task.wait(0.15)
        else
            local character, humanoid, root = getCharacter()

            if not character then
                status.Text = "Dang cho nhan vat..."
                task.wait(0.25)
            elseif not ZoneValid then
                Enabled = false
                restoreOriginalSpeed()
                updateInterface()
            else
                applyCustomSpeed(humanoid, false)

                if not isInsideZone(root.Position, Config.PlayerBoundaryTolerance) then
                    CurrentTarget = nil
                    status.Text = string.format(
                        "Ra ngoai khu vuc - dang ve trung tam | Toc do: %.0f",
                        humanoid.WalkSpeed
                    )
                    returnToZoneCenter(character, humanoid, root)
                else
                    local target = getClosestTarget(root.Position)

                    if target then
                        CurrentTarget = target
                        status.Text = string.format(
                            "Dang nhat: %s | Toc do: %.0f",
                            target.Name,
                            humanoid.WalkSpeed
                        )

                        local reached = walkThroughTarget(target, humanoid, root)

                        if target:IsDescendantOf(workspace) then
                            local cooldown = Config.FailedCooldown

                            if reached then
                                cooldown = isTotemTarget(target)
                                    and Config.TotemVisitedCooldown
                                    or Config.VisitedCooldown
                            end

                            blockTarget(target, cooldown)
                        end

                        CurrentTarget = nil
                        task.wait()
                    else
                        status.Text = string.format(
                            "Dang di tuan trong 4 goc | Toc do: %.0f",
                            humanoid.WalkSpeed
                        )

                        local patrolPoint = getRandomPatrolPoint(character)
                        humanoid:MoveTo(patrolPoint)
                        local deadline = os.clock() + Config.PatrolMoveTime

                        while Enabled and os.clock() < deadline do
                            applyCustomSpeed(humanoid, false)

                            if humanoid.Health <= 0
                                or not isInsideZone(
                                    root.Position,
                                    Config.PlayerBoundaryTolerance
                                )
                                or getClosestTarget(root.Position)
                            then
                                break
                            end

                            local _, _, _, switchDistance = getAdaptiveMovement(humanoid)
                            if horizontalDistance(root.Position, patrolPoint) <= switchDistance then
                                break
                            end

                            task.wait(Config.UpdateInterval)
                        end
                    end
                end
            end
        end
    end
end)

