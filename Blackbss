local function createBoundaryLine(first, second, color)
    local raisedFirst = first + Vector3.new(0, 0.7, 0)
    local raisedSecond = second + Vector3.new(0, 0.7, 0)
    local difference = raisedSecond - raisedFirst

    if difference.Magnitude <= 0.1 then
        return
    end

    local line = Instance.new("Part")
    line.Name = "ZoneBoundary"
    line.Size = Vector3.new(0.18, 0.18, difference.Magnitude)
    line.CFrame = CFrame.lookAt((raisedFirst + raisedSecond) / 2, raisedSecond)
    line.Color = color
    line.Material = Enum.Material.Neon
    line.Transparency = 0.2
    line.Anchored = true
    line.CanCollide = false
    line.CanTouch = false
    line.CanQuery = false
    line.Parent = PreviewFolder
end

local function refreshZonePreview()
    PreviewFolder:ClearAllChildren()

    if not Config.ShowZonePreview then
        return
    end

    for index, position in ipairs(SavedCorners) do
        createMarker(position, "Goc " .. index, Color3.fromRGB(255, 210, 50))
    end

    if ZoneValid then
        for index = 1, #ZonePoints do
            local nextIndex = index % #ZonePoints + 1
            createBoundaryLine(
                ZonePoints[index],
                ZonePoints[nextIndex],
                Color3.fromRGB(255, 205, 50)
            )
        end

        createMarker(ZoneCenter, "Trung tam", Color3.fromRGB(70, 255, 135))
    end
end

