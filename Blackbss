-- Auto Farm Field Loop
function autoFarmLoop()
    while Settings.AutoFarm do
        if not Settings.SelectedField then
            waitFor(1)
            continue
        end
        local fieldPos = getFieldPosition(Settings.SelectedField)
        local hrp = getHumanoidRootPart()
        if hrp then
            -- Kiểm tra nếu đã ở gần cánh đồng thì không cần di chuyển
            if (hrp.Position - fieldPos).Magnitude > 5 then
                tweenTo(fieldPos, Settings.TweenSpeed)
            end
            -- Ở đây có thể thêm logic thu hoạch phấn hoa (ví dụ: kích hoạt tool, chạm vào hoa)
            -- CẦN CHỈNH SỬA: Tùy vào cơ chế game, có thể cần click hoặc sử dụng tool
            -- Ví dụ: kích hoạt "Collector" tool nếu có
            local collector = getCharacter():FindFirstChildOfClass("Tool")
            if collector then
                collector:Activate()
            end
            waitFor(0.5)
        end
        task.wait()
    end
end

-- Auto Collect Loop
function autoCollectLoop()
    while Settings.AutoCollect do
        local items = getCollectibles()
        for _, item in ipairs(items) do
            if not item or not item.Parent then continue end
            collectItem(item)
        end
        waitFor(0.5)
    end
end

-- Auto Token Link Loop
function autoTokenLinkLoop()
    while Settings.AutoTokenLink do
        local links = getTokenLinks()
        for _, link in ipairs(links) do
            if link and link.Parent then
                local hrp = getHumanoidRootPart()
                local dist = (link.Position - hrp.Position).Magnitude
                if dist < 20 then -- Chỉ xử lý các link gần
                    tweenTo(link.Position, Settings.TweenSpeed)
                    waitFor(0.1)
                    -- CẦN CHỈNH SỬA: Kích hoạt token link (có thể cần nhảy vào)
                    jump()
                    waitFor(0.5)
                end
            end
        end
        waitFor(2)
    end
end

-- Auto Convert Loop
function autoConvertLoop()
    while Settings.AutoConvert do
        if isPollenFull() then
            local currentField = Settings.SelectedField
            convertPollen()
            -- Quay lại cánh đồng
            if currentField then
                local fieldPos = getFieldPosition(currentField)
                tweenTo(fieldPos, Settings.TweenSpeed)
            end
        end
        waitFor(5)
    end
end

-- Auto Map Abilities Loop
function autoMapAbilitiesLoop()
    while Settings.AutoMapAbilities do
        -- CẦN CHỈNH SỬA: Tìm và kích hoạt các ability tokens trên bản đồ
        -- Thường là các Tool nằm trên mặt đất
        local abilities = {}
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj.Name:lower():find("ability") then
                table.insert(abilities, obj)
            end
        end
        for _, ab in ipairs(abilities) do
            local handle = ab:FindFirstChild("Handle")
            if handle then
                collectItem(handle)
                waitFor(0.2)
            end
        end
        waitFor(3)
    end
end

-- Auto Kill Monsters Loop
function autoKillMonstersLoop()
    while Settings.AutoKillMonsters do
        -- Tìm quái vật theo tên
        for _, monsterName in ipairs(MonsterNames) do
            local monster = findObject(monsterName, Workspace)
            if monster and monster.Parent then
                local monsterPart = monster:IsA("Model") and monster.PrimaryPart or monster
                if monsterPart then
                    tweenTo(monsterPart.Position, Settings.TweenSpeed)
                    waitFor(0.2)
                    -- CẦN CHỈNH SỬA: Tấn công quái (có thể dùng tool vũ khí hoặc kỹ năng)
                    local weapon = getCharacter():FindFirstChildOfClass("Tool")
                    if weapon then
                        weapon:Activate()
                    end
                    -- Giả lập click chuột trái
                    VirtualUser:Button1Down()
                    waitFor(0.5)
                    VirtualUser:Button1Up()
                    waitFor(1)
                end
            end
        end
        waitFor(5)
    end
end

-- Auto Dispenser Loop
function autoDispenserLoop()
    while Settings.AutoDispenser do
        -- CẦN CHỈNH SỬA: Tìm các dispenser (Blue/Red, Treat, Glue, Coconut)
        local dispensers = {}
        local dispenserNames = {"Blue Dispenser", "Red Dispenser", "Treat Dispenser", "Glue Dispenser", "Coconut Dispenser"}
        for _, dispName in ipairs(dispenserNames) do
            local disp = findObject(dispName, Workspace)
            if disp then
                table.insert(dispensers, disp)
            end
        end
        for _, disp in ipairs(dispensers) do
            if disp.Parent then
                local dispPart = disp:IsA("Model") and disp.PrimaryPart or disp
                if dispPart then
                    tweenTo(dispPart.Position, Settings.TweenSpeed)
                    waitFor(0.2)
                    -- Kích hoạt nhận thưởng
                    jump()
                    waitFor(0.5)
                end
            end
        end
        waitFor(60) -- Kiểm tra mỗi 60 giây
    end
end

-- Auto Field Boosters Loop
function autoFieldBoostersLoop()
    while Settings.AutoFieldBoosters do
        -- CẦN CHỈNH SỬA: Tìm các máy boosters ở Mountain Top, Blue HQ, Red HQ
        local boosters = {}
        local boosterLocations = {"Mountain Top Booster", "Blue HQ Booster", "Red HQ Booster"}
        for _, bName in ipairs(boosterLocations) do
            local booster = findObject(bName, Workspace)
            if booster then
                table.insert(boosters, booster)
            end
        end
        for _, booster in ipairs(boosters) do
            if booster.Parent then
                local boosterPart = booster:IsA("Model") and booster.PrimaryPart or booster
                if boosterPart then
                    tweenTo(boosterPart.Position, Settings.TweenSpeed)
                    waitFor(0.2)
                    jump()
                    waitFor(0.5)
                end
            end
        end
        waitFor(120) -- Kiểm tra mỗi 2 phút
    end
end

-- ==================== HỆ THỐNG AUTO RECONNECT ====================
local function autoReconnect()
    while true do
        if not LocalPlayer:IsConnected() then
            warn("Mất kết nối! Đang thử kết nối lại...")
            -- Có thể sử dụng TeleportService để kết nối lại
            local TeleportService = game:GetService("TeleportService")
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
            waitFor(10)
        end
        waitFor(5)
    end
end

