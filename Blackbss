MinimizeBtn.BackgroundColor3 = Color3.fromRGB(180, 80, 40)

-- [ CÁC BIẾN HOẠT ĐỘNG ]
local autoFarm = false
local autoCollect = false
local myHiveCFrame = nil 

FarmBtn.MouseButton1Click:Connect(function()
    autoFarm = not autoFarm
    FarmBtn.Text = autoFarm and "Farm Ngầm: BẬT" or "Farm Ngầm: TẮT"
    FarmBtn.BackgroundColor3 = autoFarm and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(50, 50, 50)
end)

CollectBtn.MouseButton1Click:Connect(function()
    autoCollect = not autoCollect
    CollectBtn.Text = autoCollect and "Đi Bộ Nhặt: BẬT" or "Đi Bộ Nhặt: TẮT"
    CollectBtn.BackgroundColor3 = autoCollect and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(50, 50, 50)
end)

SaveHiveBtn.MouseButton1Click:Connect(function()
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        myHiveCFrame = player.Character.HumanoidRootPart.CFrame
        SaveHiveBtn.Text = "Đã Lưu Tổ!"
        SaveHiveBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 30)
        task.wait(1)
        SaveHiveBtn.Text = "Lưu Vị Trí Tổ"
        SaveHiveBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end
end)

HiveBtn.MouseButton1Click:Connect(function()
    if not myHiveCFrame then return end
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame = myHiveCFrame
    end
end)

