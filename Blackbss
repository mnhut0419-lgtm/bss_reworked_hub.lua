local function stopMoving()
    local _, humanoid, root = getCharacter()

    if humanoid and root then
        humanoid:MoveTo(root.Position)
    end
end

local function updateToggleButton()
    if Enabled then
        toggleButton.Text = "DỪNG"
        toggleButton.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
    else
        toggleButton.Text = "BẮT ĐẦU"
        toggleButton.BackgroundColor3 = Color3.fromRGB(45, 170, 95)
    end
end

toggleButton.Activated:Connect(function()
    if Enabled then
        Enabled = false
        CurrentTarget = nil
        status.Text = "Đã dừng"
        stopMoving()
    else
        local _, _, root = getCharacter()

        if not root then
            status.Text = "Không tìm thấy nhân vật"
            return
        end

        FieldCenter = root.Position
        Enabled = true
        status.Text = "Đang tìm Token và Totem..."
    end

    updateToggleButton()
end)

--==============================================================
-- VÒNG LẶP CHÍNH
--==============================================================

task.spawn(function()
    while gui.Parent do
        if not Enabled then
            task.wait(0.15)
        else
            local character, humanoid, root = getCharacter()

            if not character then
                status.Text = "Đang chờ nhân vật..."
                task.wait(0.25)
            else
                local target = getClosestTarget(root.Position)

                if target then
                    CurrentTarget = target
                    status.Text = "Đang nhặt: " .. target.Name

                    local reached = walkThroughTarget(
                        target,
                        humanoid,
                        root
                    )

                    if target:IsDescendantOf(workspace) then
                        if reached then
                            -- Bỏ qua mục tiêu vừa chạm và đi tiếp ngay
                            blockTarget(
                                target,
                                Config.VisitedCooldown
                            )
                        else
                            blockTarget(
                                target,
                                Config.FailedCooldown
                            )
                        end
                    end

                    CurrentTarget = nil

                    -- Không task.wait tại đây:
                    -- lập tức chọn mục tiêu tiếp theo
                else
                    status.Text = "Đang đi tuần quanh khu vườn"

                    local patrolPoint = getRandomPatrolPoint(character)
                    humanoid:MoveTo(patrolPoint)

                    local deadline = os.clock()
                        + Config.PatrolMoveTime

                    while Enabled and os.clock() < deadline do
                        if humanoid.Health <= 0 then
                            break
                        end

                        -- Có vật phẩm mới thì chuyển hướng ngay
                        if getClosestTarget(root.Position) then
                            break
                        end

                        -- Đổi điểm trước khi tới hẳn để không đứng lại
                        if horizontalDistance(
                            root.Position,
                            patrolPoint
                        ) <= Config.PatrolSwitchDistance then
                            break
                        end

                        task.wait(Config.UpdateInterval)
                    end
                end
            end
        end
    end
end)

Player.CharacterRemoving:Connect(function()
    if Enabled then
        Enabled = false
        CurrentTarget = nil
        status.Text = "Nhân vật hồi sinh — hãy bật lại"
        updateToggleButton()
    end
end)
