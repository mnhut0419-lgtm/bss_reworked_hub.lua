local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

local CONFIG = {
    TotemNames = {"Totem", "Pollen", "Honey", "Token", "Collect"},
    SearchRadius = 120,
    MoveSpeed = 16,
    LoopDelay = 0.3,
}

local function getRemote()
    local remote = nil
    local possibleNames = {"Collect", "CollectTotem", "Gather", "Claim", "RemoteEvent", "GameEvent"}
    for _, name in ipairs(possibleNames) do
        remote = game:GetService("ReplicatedStorage"):FindFirstChild(name)
        if remote then break end
        remote = workspace:FindFirstChild(name)
        if remote then break end
    end
    return remote
end

local function findNearestTotem()
    local nearest = nil
    local minDist = CONFIG.SearchRadius
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name
            for _, keyword in ipairs(CONFIG.TotemNames) do
                if string.find(name:lower(), keyword:lower()) then
                    local pos
                    if obj:IsA("Model") and obj.PrimaryPart then
                        pos = obj.PrimaryPart.Position
                    elseif obj:IsA("BasePart") then
                        pos = obj.Position
                    end
                    if pos then
                        local dist = (pos - rootPart.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            nearest = {Object = obj, Position = pos, Distance = dist}
                        end
                    end
                    break
                end
            end
        end
    end
    return nearest
end

local function interactWithTotem(totemData)
    local obj = totemData.Object
    local success = false

    local click = obj:FindFirstChild("ClickDetector")
    if click then
        click:Click()
        success = true
    end

    local remote = getRemote()
    if remote then
        pcall(function()
            remote:FireServer(obj)
            success = true
        end)
        if not success then
            pcall(function()
                remote:FireServer(obj.Name, obj.Position)
                success = true
            end)
        end
        if not success then
            pcall(function()
                remote:FireServer("Collect", obj)
                success = true
            end)
        end
    end

    local tool = player.Backpack:FindFirstChild("Collector") or player.Character:FindFirstChild("Collector")
    if tool then
        pcall(function()
            tool:Activate()
            success = true
        end)
    end

    return success
end

print("[BSS Auto] Da khoi dong (mobile)")

while true do
    pcall(function()
        local nearest = findNearestTotem()
        if nearest then
            local pos = nearest.Position
            local dist = nearest.Distance

            if dist > 5 then
                humanoid:MoveTo(pos)
                wait(math.min(dist / CONFIG.MoveSpeed, 2))
            end

            if dist < 8 then
                local ok = interactWithTotem(nearest)
                if ok then
                    print("[BSS Auto] Da nhat: " .. nearest.Object.Name)
                else
                    print("[BSS Auto] Khong the nhat " .. nearest.Object.Name .. " – thu cach khac")
                end
                wait(0.5)
            end
        else
            rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.rad(5), 0)
            wait(1)
        end
    end)
    wait(CONFIG.LoopDelay)
end
