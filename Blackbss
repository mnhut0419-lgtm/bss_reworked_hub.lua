-- Hàm chờ nhân vật sẵn sàng
local function waitForCharacter()
    repeat task.wait() until LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character:FindFirstChild("Humanoid")
    return LocalPlayer.Character
end

-- Hàm lấy RootPart
local function getRootPart()
    local char = waitForCharacter()
    return char.HumanoidRootPart
end

-- Hàm di chuyển bằng Tween
local function tweenToPosition(position)
    local root = getRootPart()
    local distance = (position - root.Position).Magnitude
    local tweenTime = distance / Settings.TweenSpeed
    local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(root, tweenInfo, {CFrame = CFrame.new(position)})
    tween:Play()
    tween.Completed:Wait()
end

-- Hàm tìm object theo tên (trả về phần PrimaryPart nếu là Model)
local function findObject(name)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == name then
            if obj:IsA("Model") and obj.PrimaryPart then
                return obj.PrimaryPart
            elseif obj:IsA("BasePart") then
                return obj
            end
        end
    end
    return nil
end

-- Lấy vị trí cánh đồng (CẦN CHỈNH theo game)
local function getFieldPosition(fieldName)
    local part = findObject(fieldName)
    if part then
        return part.Position
    else
        warn("Không tìm thấy field:", fieldName)
        return nil
    end
end

-- Lấy vị trí Hive (CẦN CHỈNH)
local function getHivePosition()
    local hive = findObject("Hive") -- hoặc tên chính xác
    if hive then
        return hive.Position
    else
        warn("Không tìm thấy Hive")
        return nil
    end
end

-- Kiểm tra phấn hoa đầy (CẦN CHỈNH)
local function isPollenFull()
    local pollen = LocalPlayer:FindFirstChild("Pollen") or LocalPlayer:FindFirstChild("PollenCount")
    local maxPollen = LocalPlayer:FindFirstChild("MaxPollen") or LocalPlayer:FindFirstChild("PollenCapacity")
    if pollen and maxPollen then
        return pollen.Value >= maxPollen.Value
    end
    return false
end

