-- ==================== HÀM TIỆN ÍCH ====================
local function getPlayer()
    return LocalPlayer
end

local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHumanoidRootPart()
    local char = getCharacter()
    local hrp = char:WaitForChild("HumanoidRootPart")
    return hrp
end

-- Hàm tìm object theo tên (hỗ trợ tìm trong Workspace)
local function findObject(name, parent)
    parent = parent or Workspace
    for _, obj in ipairs(parent:GetDescendants()) do
        if obj.Name == name or obj:IsA(name) then
            return obj
        end
    end
    return nil
end

-- Hàm di chuyển bằng Tween
local function tweenTo(position, speed)
    local hrp = getHumanoidRootPart()
    if not hrp then return end
    local distance = (position - hrp.Position).Magnitude
    local tweenTime = distance / (speed or Settings.TweenSpeed)
    local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(position)})
    tween:Play()
    tween.Completed:Wait()
end

-- Hàm chờ đợi an toàn
local function waitFor(seconds)
    task.wait(seconds or 0.1)
end

-- Hàm gửi yêu cầu nhảy (để tránh bị kẹt)
local function jump()
    local char = getCharacter()
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end

