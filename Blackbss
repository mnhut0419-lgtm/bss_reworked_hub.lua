-- Button Creator
local function createButton(yPos, text, color)
    local btn = Instance.new("TextButton")
    btn.Parent = Frame
    btn.Size = UDim2.new(0.9, 0, 0, 38)
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.Text = text
    btn.BackgroundColor3 = color or Color3.fromRGB(55, 55, 60)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.BorderSizePixel = 0
    return btn
end

-- Toggle Creator
local function createToggle(yPos, text, defaultState)
    local toggleFrame = Instance.new("Frame")
    toggleFrame.Parent = Frame
    toggleFrame.Size = UDim2.new(0.9, 0, 0, 38)
    toggleFrame.Position = UDim2.new(0.05, 0, 0, yPos)
    toggleFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    toggleFrame.BorderSizePixel = 0
    
    local label = Instance.new("TextLabel")
    label.Parent = toggleFrame
    label.Size = UDim2.new(0.65, 0, 1, 0)
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.SourceSans
    label.TextSize = 13
    label.TextWrapped = true
    
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Parent = toggleFrame
    toggleBtn.Size = UDim2.new(0.35, 0, 0.8, 0)
    toggleBtn.Position = UDim2.new(0.65, 0, 0.1, 0)
    toggleBtn.Text = defaultState and "✅ ON" or "❌ OFF"
    toggleBtn.BackgroundColor3 = defaultState and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(160, 40, 40)
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.Font = Enum.Font.SourceSansBold
    toggleBtn.TextSize = 13
    toggleBtn.BorderSizePixel = 0
    
    return toggleBtn
end

