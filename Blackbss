-- [ LOGIC 1: VUNG GẬY (CHẠY NGẦM) ]
task.spawn(function()
    while task.wait(0.1) do
        if autoFarm or autoCollect then -- Bật 1 trong 2 đều tự vung gậy
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") then
                local tool = char:FindFirstChildOfClass("Tool")
                if not tool then
                    local bpTool = player.Backpack:FindFirstChildOfClass("Tool")
                    if bpTool then 
                        char.Humanoid:EquipTool(bpTool)
                        tool = bpTool
                    end
                end
                if tool then
                    tool:Activate()
                end
            end
        end
    end
end)

-- [ LOGIC 2: TỰ ĐỘNG ĐI BỘ TÌM VÀ NHẶT KỸ NĂNG ]
local function getNearestToken(radius)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local root = char.HumanoidRootPart
    
    local nearestToken = nil
    local shortestDistance = radius

    -- Quét toàn bộ map để tìm token
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local objName = obj.Name:lower()
            local parentName = obj.Parent and obj.Parent.Name:lower() or ""
            
            -- Lọc các part là Token/Kỹ năng (thường tên là token, drop, coin, c, hoặc nằm trong folder Collectibles)
            if objName:match("token") or objName:match("drop") or objName:match("coin") or objName == "c" or parentName:match("collectible") or parentName:match("token") then
                local distance = (obj.Position - root.Position).Magnitude
                
                -- Tìm token gần nhất trong bán kính
                if distance <= shortestDistance then
                    shortestDistance = distance
                    nearestToken = obj
                end
            end
        end
    end
    
    return nearestToken
end

task.spawn(function()
    while task.wait(0.2) do
        if autoCollect then
            local char = player.Character
            if char then
                local humanoid = char:FindFirstChild("Humanoid")
                if humanoid then
                    -- Tìm token gần nhất trong phạm vi 60 mét (1 khu vườn)
                    local targetToken = getNearestToken(60)
                    
                    if targetToken then
                        -- Điều khiển nhân vật ĐI BỘ tới token
                        humanoid:MoveTo(targetToken.Position)
                    end
                end
            end
        end
    end
end)
