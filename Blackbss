local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local Config = {
    FieldRadius = 85,
    ScanRadius = 110,

    -- Khoảng cách được tính là đã chạm vật phẩm
    ReachDistance = 5,

    -- Nhân vật tiếp tục đi xuyên qua mục tiêu để không bị khựng
    PassThroughDistance = 4,

    -- Chu kỳ cập nhật chuyển động
    UpdateInterval = 0.05,

    MoveTimeout = 7,

    -- Không chọn lại Totem vừa chạm trong thời gian này
    VisitedCooldown = 12,
    FailedCooldown = 6,

    PatrolMoveTime = 4,
    PatrolSwitchDistance = 6,

    CollectibleTag = "Collectible",

    AttributeNames = {
        "Collectible",
        "Pickup",
        "Token",
        "Totem",
    },

    NameKeywords = {
        "token",
        "totem",
        "drop",
        "coin",
        "item",
        "pickup",
        "collectible",
    },
}

local Enabled = false
local FieldCenter = nil
local CurrentTarget = nil

local Tracked = setmetatable({}, { __mode = "k" })
local BlockedUntil = setmetatable({}, { __mode = "k" })

--==============================================================
-- NHẬN DIỆN VẬT PHẨM
--==============================================================

local function containsKeyword(name)
    name = string.lower(name)

    for _, keyword in ipairs(Config.NameKeywords) do
        if string.find(name, keyword, 1, true) then
            return true
        end
    end

    return false
end

local function hasCollectibleMarker(instance)
    if CollectionService:HasTag(instance, Config.CollectibleTag) then
        return true
    end

    for _, attributeName in ipairs(Config.AttributeNames) do
        if instance:GetAttribute(attributeName) == true then
            return true
        end
    end

    return containsKeyword(instance.Name)
end

local function resolveCollectible(part)
    -- Ưu tiên Model để tránh một Totem có nhiều Part
    local ancestor = part.Parent

    for _ = 1, 3 do
        if not ancestor or ancestor == workspace then
            break
        end

        if hasCollectibleMarker(ancestor) then
            if ancestor:IsA("Model") then
                return ancestor
            end

            return part
        end

        ancestor = ancestor.Parent
    end

    if hasCollectibleMarker(part) then
        return part
    end

    return nil
end

local function registerInstance(instance)
    if instance:IsA("BasePart") then
        local collectible = resolveCollectible(instance)

        if collectible then
            Tracked[collectible] = true
        end
    elseif instance:IsA("Model") and hasCollectibleMarker(instance) then
        Tracked[instance] = true
    end
end

workspace.DescendantAdded:Connect(registerInstance)

workspace.DescendantRemoving:Connect(function(instance)
    Tracked[instance] = nil
    BlockedUntil[instance] = nil

    if CurrentTarget == instance then
        CurrentTarget = nil
    end
end)

CollectionService
    :GetInstanceAddedSignal(Config.CollectibleTag)
    :Connect(registerInstance)

-- Chỉ quét toàn bộ Workspace một lần
task.spawn(function()
    for index, instance in ipairs(workspace:GetDescendants()) do
        registerInstance(instance)

        if index % 800 == 0 then
            task.wait()
        end
    end
end)

--==============================================================
-- NHÂN VẬT VÀ MỤC TIÊU
--==============================================================

local function getCharacter()
    local character = Player.Character
    if not character then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return nil
    end

    return character, humanoid, root
end

local function getTargetPosition(target)
    if target:IsA("BasePart") then
        return target.Position
    end

    if target:IsA("Model") then
        local part = target.PrimaryPart
            or target:FindFirstChildWhichIsA("BasePart", true)

        if part then
            return part.Position
        end
    end

    return nil
end

local function horizontalDistance(firstPosition, secondPosition)
    local difference = firstPosition - secondPosition

    return Vector2.new(
        difference.X,
        difference.Z
    ).Magnitude
end

local function getClosestTarget(rootPosition)
    if not FieldCenter then
        return nil
    end

    local closestTarget = nil
    local closestDistance = Config.ScanRadius
    local currentTime = os.clock()

    for target in pairs(Tracked) do
        if not target:IsDescendantOf(workspace) then
            Tracked[target] = nil
            BlockedUntil[target] = nil
        else
            local blockTime = BlockedUntil[target]

            if not blockTime or blockTime <= currentTime then
                local position = getTargetPosition(target)

                if position
                    and horizontalDistance(
                        position,
                        FieldCenter
                    ) <= Config.FieldRadius
                then
                    local distance = (
                        position - rootPosition
                    ).Magnitude

                    if distance < closestDistance then
                        closestDistance = distance
                        closestTarget = target
                    end
                end
            end
        end
    end

    return closestTarget
end

local function blockTarget(target, duration)
    local untilTime = os.clock() + duration
    BlockedUntil[target] = untilTime

    -- Nếu mục tiêu là Model, chặn luôn các Part đã được cache
    if target:IsA("Model") then
        for otherTarget in pairs(Tracked) do
            if otherTarget ~= target
                and otherTarget:IsDescendantOf(target)
            then
                BlockedUntil[otherTarget] = untilTime
            end
        end
    end
end

--==============================================================
-- DI CHUYỂN LIÊN TỤC
--==============================================================

local function walkThroughTarget(target, humanoid, root)
    local deadline = os.clock() + Config.MoveTimeout
    local previousGoal = nil

    while Enabled and os.clock() < deadline do
        if humanoid.Health <= 0 then
            return false
        end

        -- Token đã biến mất: server đã nhận lần chạm
        if not target:IsDescendantOf(workspace) then
            return true
        end

        local targetPosition = getTargetPosition(target)

        if not targetPosition then
            return false
        end

        local difference = targetPosition - root.Position
        local distance = difference.Magnitude

        -- Không dừng và không chờ tại mục tiêu
        if distance <= Config.ReachDistance then
            return true
        end

        local movementGoal = targetPosition

        -- Đi quá vị trí mục tiêu một đoạn để nhân vật không giảm tốc
        if distance > 0.01 then
            movementGoal = targetPosition
                + difference.Unit * Config.PassThroughDistance
        end

        if not previousGoal
            or (movementGoal - previousGoal).Magnitude >= 1
        then
            humanoid:MoveTo(movementGoal)
            previousGoal = movementGoal
        end

        task.wait(Config.UpdateInterval)
    end

    return false
end

local function getRandomPatrolPoint(character)
    local angle = math.random() * math.pi * 2
    local radius = math.sqrt(math.random())
        * Config.FieldRadius
        * 0.85

    local flatPosition = FieldCenter + Vector3.new(
        math.cos(angle) * radius,
        0,
        math.sin(angle) * radius
    )

    local raycastParameters = RaycastParams.new()
    raycastParameters.FilterType = Enum.RaycastFilterType.Exclude
    raycastParameters.FilterDescendantsInstances = { character }

    local result = workspace:Raycast(
        flatPosition + Vector3.new(0, 60, 0),
        Vector3.new(0, -140, 0),
        raycastParameters
    )

    if result then
        return result.Position + Vector3.new(0, 2, 0)
    end

    return Vector3.new(
        flatPosition.X,
        FieldCenter.Y,
        flatPosition.Z
    )
end

