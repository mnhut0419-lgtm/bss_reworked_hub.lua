local function getRig()
	local character = player.Character
	if not character then
		return nil, nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		return character, nil, nil
	end

	return character, humanoid, root
end

local function getLeaderstats()
	return player:FindFirstChild("leaderstats")
end

-- Ho tro ca IntValue/NumberValue va Attribute tren leaderstats.
local function readStat(statName)
	local leaderstats = getLeaderstats()
	if not leaderstats then
		return nil, "Khong tim thay leaderstats"
	end

	local valueObject = leaderstats:FindFirstChild(statName)
	if valueObject and valueObject:IsA("ValueBase") then
		local value = valueObject.Value
		if type(value) == "number" then
			return value, nil
		end
	end

	local attributeValue = leaderstats:GetAttribute(statName)
	if type(attributeValue) == "number" then
		return attributeValue, nil
	end

	return nil, "Thieu du lieu " .. statName
end

local function readBag()
	local current, currentError = readStat("Current")
	if current == nil then
		return nil, nil, currentError
	end

	local capacity, capacityError = readStat("Capacity")
	if capacity == nil then
		return nil, nil, capacityError
	end

	return current, capacity, nil
end

local function writeCurrent(newValue)
	local leaderstats = getLeaderstats()
	if not leaderstats then
		return false
	end

	local valueObject = leaderstats:FindFirstChild("Current")
	if valueObject and valueObject:IsA("ValueBase") then
		valueObject.Value = newValue
		return true
	end

	if leaderstats:GetAttribute("Current") ~= nil then
		leaderstats:SetAttribute("Current", newValue)
		return true
	end

	return false
end

local function isBagFull()
	local current, capacity = readBag()
	return current ~= nil and capacity ~= nil and capacity > 0 and current >= capacity
end

local function findTool()
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	local wantedName = string.lower(Config.ToolName)

	for _, container in ipairs({character, backpack}) do
		if container then
			local exactTool = container:FindFirstChild(Config.ToolName)
			if exactTool and exactTool:IsA("Tool") then
				return exactTool
			end

			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") and string.lower(child.Name) == wantedName then
					return child
				end
			end
		end
	end

	return nil
end

local function equipTool()
	local character, humanoid = getRig()
	if not character or not humanoid or humanoid.Health <= 0 then
		return nil
	end

	local tool = findTool()
	if not tool then
		return nil
	end

	if tool.Parent ~= character then
		humanoid:EquipTool(tool)
		task.wait(0.05)
	end

	if tool.Parent == character then
		return tool
	end

	return nil
end

local function stopTool()
	toolActivationEnabled = false
	local tool = findTool()
	if tool then
		pcall(function()
			tool:Deactivate()
		end)
	end
end

--============================================================
-- TWEEN MOVEMENT
--============================================================

local function cancelMovement()
	movementVersion = movementVersion + 1
	if currentTween then
		pcall(function()
			currentTween:Cancel()
		end)
		currentTween = nil
	end
end

local function tweenTo(targetPosition)
	local _, humanoid, root = getRig()
	if not humanoid or not root or humanoid.Health <= 0 then
		return false
	end

	cancelMovement()
	local thisMovement = movementVersion
	local distance = (root.Position - targetPosition).Magnitude
	if distance <= Config.ArrivalDistance then
		return true
	end

	local speed = math.max(Config.MovementSpeed, 1)
	local duration = math.max(distance / speed, 0.05)
	local targetCFrame = CFrame.new(targetPosition) * root.CFrame.Rotation
	local oldAutoRotate = humanoid.AutoRotate

	humanoid.AutoRotate = false
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	local tween = TweenService:Create(
		root,
		TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{CFrame = targetCFrame}
	)

	currentTween = tween
	local finished = false
	local result = Enum.PlaybackState.Cancelled
	local completedConnection

	completedConnection = tween.Completed:Connect(function(playbackState)
		result = playbackState
		finished = true
	end)

	tween:Play()

	while alive and autoPlayEnabled and thisMovement == movementVersion and not finished do
		task.wait(0.05)
	end

	if not finished then
		pcall(function()
			tween:Cancel()
		end)
	end

	if completedConnection then
		completedConnection:Disconnect()
	end

	if currentTween == tween then
		currentTween = nil
	end

	if humanoid.Parent then
		humanoid.AutoRotate = oldAutoRotate
	end

	if root.Parent then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	return result == Enum.PlaybackState.Completed
		and alive
		and autoPlayEnabled
		and thisMovement == movementVersion
end

--============================================================
-- UI ACTIONS AND SHUTDOWN
--============================================================

local function updateToggleAppearance()
	if autoPlayEnabled then
		toggleButton.Text = "TAT AUTO-PLAY"
		toggleButton.BackgroundColor3 = Colors.Red
	else
		toggleButton.Text = "BAT AUTO-PLAY"
		toggleButton.BackgroundColor3 = Colors.Green
	end
end

local function applyInputs()
	local trimmedToolName = string.match(toolBox.Text, "^%s*(.-)%s*$") or ""
	if trimmedToolName == "" then
		setStatus("Loi: Hay nhap ten Tool", Colors.Red)
		return false
	end

	local speed = tonumber(speedBox.Text)
	if not speed then
		setStatus("Loi: Toc do phai la mot con so", Colors.Red)
		return false
	end

	Config.ToolName = trimmedToolName
	Config.MovementSpeed = math.clamp(speed, 5, 200)
	speedBox.Text = tostring(Config.MovementSpeed)
	return true
end

local function setAutoPlay(enabled)
	if enabled and not applyInputs() then
		return
	end

	autoPlayEnabled = enabled
	updateToggleAppearance()

	if not enabled then
		stopTool()
		cancelMovement()
		setState(State.OFF, "Trang thai: Da tat", Colors.Muted)
	else
		setState(State.WAITING_CHARACTER, "Dang khoi dong Auto-Play...", Colors.Orange)
	end
end

local function shutdown()
	if not alive then
		return
	end

	alive = false
	autoPlayEnabled = false
	stopTool()
	cancelMovement()

	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)

	if gui and gui.Parent then
		gui:Destroy()
	end
end

