task.spawn(function()
    while gui.Parent do
        if Enabled and Config.AutoSwingEnabled then
            local character, humanoid = getCharacter()

            if character and humanoid then
                local tool = findCollectorTool(character, humanoid)

                if tool and tool.Parent == character then
                    if SwingToolMissing then
                        SwingToolMissing = false
                        updateAutoSwingInterface()
                    end

                    if HeldSwingTool and HeldSwingTool ~= tool then
                        releaseSwingTool()
                    end

                    HeldSwingTool = tool

                    -- Khong chan bang Tool.Enabled: mot so Tool tuy bien tu quan ly hoi chieu.
                    pcall(function()
                        tool:Activate()
                    end)

                    task.wait(Config.SwingHoldSeconds)

                    if HeldSwingTool == tool then
                        pcall(function()
                            tool:Deactivate()
                        end)
                        HeldSwingTool = nil
                    end

                    task.wait(Config.SwingReleaseSeconds)
                else
                    releaseSwingTool()

                    if not SwingToolMissing then
                        SwingToolMissing = true
                        updateAutoSwingInterface()
                        status.Text = "Khong tim thay Roblox Tool tren nhan vat."
                    end

                    task.wait(0.20)
                end
            else
                releaseSwingTool()
                task.wait(0.20)
            end
        else
            releaseSwingTool()
            task.wait(0.20)
        end
    end
end)

