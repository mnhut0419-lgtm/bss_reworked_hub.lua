local function getCharacter()
    local character = Player.Character
    if not character then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return nil
    end

    return character, humanoid, root
end

local function captureOriginalSpeed(humanoid)
    if SpeedHumanoid ~= humanoid then
        SpeedHumanoid = humanoid
        OriginalWalkSpeed = humanoid.WalkSpeed
    elseif OriginalWalkSpeed == nil then
        OriginalWalkSpeed = humanoid.WalkSpeed
    end
end

local function applyCustomSpeed(humanoid, force)
    if not Config.CustomSpeedEnabled or not humanoid then
        return
    end

    captureOriginalSpeed(humanoid)

    local now = os.clock()
    if force or now - LastSpeedEnforce >= Config.SpeedEnforceInterval then
        LastSpeedEnforce = now

        if math.abs(humanoid.WalkSpeed - Config.SelectedWalkSpeed) > 0.01 then
            humanoid.WalkSpeed = Config.SelectedWalkSpeed
        end
    end
end

local function restoreOriginalSpeed()
    if SpeedHumanoid
        and SpeedHumanoid.Parent
        and OriginalWalkSpeed ~= nil
    then
        SpeedHumanoid.WalkSpeed = OriginalWalkSpeed
    end

    SpeedHumanoid = nil
    OriginalWalkSpeed = nil
    LastSpeedEnforce = 0
end

local function horizontalDistance(first, second)
    local difference = first - second
    return Vector2.new(difference.X, difference.Z).Magnitude
end

local function getAdaptiveMovement(humanoid)
    local speed = math.max(humanoid.WalkSpeed, 1)

    local passThroughDistance = math.clamp(
        speed * Config.PassThroughTime,
        Config.MinimumPassThroughDistance,
        Config.MaximumPassThroughDistance
    )

    local reachDistance = math.clamp(
        Config.MinimumReachDistance + speed * 0.012,
        Config.MinimumReachDistance,
        Config.MaximumReachDistance
    )

    local patrolSwitchDistance = math.clamp(
        speed * Config.PatrolLookAheadTime,
        Config.PatrolSwitchDistance,
        Config.MaximumPatrolSwitchDistance
    )

    return speed, passThroughDistance, reachDistance, patrolSwitchDistance
end

local function distanceFromPointToSegment(point, segmentStart, segmentEnd)
    local segment = segmentEnd - segmentStart
    local lengthSquared = segment:Dot(segment)

    if lengthSquared <= 0.001 then
        return (point - segmentStart).Magnitude
    end

    local progress = math.clamp(
        (point - segmentStart):Dot(segment) / lengthSquared,
        0,
        1
    )

    local nearestPoint = segmentStart + segment * progress
    return (point - nearestPoint).Magnitude
end

local function findCollectorTool(character, humanoid)
    local equippedTool = character:FindFirstChildOfClass("Tool")
    if equippedTool then
        return equippedTool
    end

    if not Config.AutoEquipTool then
        return nil
    end

    local backpack = Player:FindFirstChildOfClass("Backpack")
    if not backpack then
        return nil
    end

    local selectedTool = nil

    if Config.PreferredToolName ~= "" then
        local exactTool = backpack:FindFirstChild(Config.PreferredToolName)
        if exactTool and exactTool:IsA("Tool") then
            selectedTool = exactTool
        end
    else
        selectedTool = backpack:FindFirstChildOfClass("Tool")
    end

    if selectedTool then
        humanoid:EquipTool(selectedTool)
    end

    return selectedTool
end

local function releaseSwingTool()
    if HeldSwingTool then
        pcall(function()
            HeldSwingTool:Deactivate()
        end)
    end

    HeldSwingTool = nil
end

