local function formatPosition(position)
	return string.format("%.1f, %.1f, %.1f", position.X, position.Y, position.Z)
end

local function refreshPositionLabels()
	fieldPositionLabel.Text = "Field: " .. formatPosition(Config.FieldPosition)
	hivePositionLabel.Text = "Hive: " .. formatPosition(Config.HivePosition)
end

