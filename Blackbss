-- Vòng lặp Auto Click
task.spawn(function()
    while task.wait(0.1) do
        if _G.AutoClick then
            vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(0.05)
            vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end
    end
end)

-- Vòng lặp quét và tự đi nhặt item (Đã tối ưu hóa cho game fan-made)
task.spawn(function()
    while task.wait(0.2) do
        if _G.AutoCollect then
            pcall(function()
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                    local root = char.HumanoidRootPart
                    local hum = char.Humanoid
                    local targetPos = nil
                    local shortestDist = 50 -- Bán kính vừa phải để tránh chạy loạn xạ
                    
                    -- Tìm kiếm các item/token đang rơi xung quanh nhân vật
                    for _, v in pairs(workspace:GetDescendants()) do
                        if v:IsA("BasePart") then
                            -- Kiểm tra xem vật thể có chứa TouchInterest (tương tác chạm) hoặc thuộc thư mục chứa đồ rơi
                            if v:FindFirstChild("TouchInterest") and not v.Parent:FindFirstChild("Humanoid") then
                                local dist = (v.Position - root.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    targetPos = v.Position
                                end
                            end
                        end
                    end
                    
                    -- Ra lệnh nhân vật di chuyển tới vị trí item
                    if targetPos then 
                        hum:MoveTo(targetPos) 
                    end
                end
            end)
        end
    end
end)

