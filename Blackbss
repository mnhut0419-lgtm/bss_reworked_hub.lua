--!strict

--[[
    IN-GAME AUTO-PLAY
    Vị trí đề xuất:
    StarterPlayer > StarterPlayerScripts > AutoPlay.client.lua
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- CẤU HÌNH
--==================================================

local Config = {
    FieldPosition = Vector3.new(100, 5, 200),
    HivePosition = Vector3.new(0, 5, 0),

    ToolName = "Collector",

    MovementSpeed = 35,       -- Stud/giây
    ToolActivationDelay = 0.15,
    ProcessingTime = 5,
    LoopDelay = 0.15,

    HeightOffset = 3,
}

--==================================================
-- STATE MACHINE
--==================================================

local State = {
    IDLE = "IDLE",
    MOVING_TO_FIELD = "MOVING_TO_FIELD",
    FARMING = "FARMING",
    MOVING_TO_HIVE = "MOVING_TO_HIVE",
    PROCESSING = "PROCESSING",
}

local currentState = State.IDLE
local toolActivationEnabled = false
local scriptRunning = true
local activeTween: Tween? = nil

--==================================================
-- THAM CHIẾU NHÂN VẬT
--==================================================

local character: Model
local humanoid: Humanoid
local rootPart: BasePart
local backpack: Backpack

local function loadCharacter(newCharacter: Model)
    character = newCharacter
    humanoid = character:WaitForChild("Humanoid") :: Humanoid
    rootPart = character:WaitForChild("HumanoidRootPart") :: BasePart
    backpack = LocalPlayer:WaitForChild("Backpack") :: Backpack

    currentState = State.IDLE
    toolActivationEnabled = false
end

loadCharacter(LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait())

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    loadCharacter(newCharacter)
end)

--==================================================
-- LEADERSTATS
--==================================================

local leaderstats = LocalPlayer:WaitForChild("leaderstats")
local currentValue = leaderstats:WaitForChild("Current") :: NumberValue
local capacityValue = leaderstats:WaitForChild("Capacity") :: NumberValue

local function isBagFull(): boolean
    local capacity = capacityValue.Value

    if capacity <= 0 then
        return false
    end

    return currentValue.Value >= capacity
end

--==================================================
-- CÔNG CỤ
--==================================================

local function findTool(): Tool?
    if not character or not backpack then
        return nil
    end

    local equippedTool = character:FindFirstChild(Config.ToolName)
    if equippedTool and equippedTool:IsA("Tool") then
        return equippedTool
    end

    local storedTool = backpack:FindFirstChild(Config.ToolName)
    if storedTool and storedTool:IsA("Tool") then
        return storedTool
    end

    return nil
end

local function equipConfiguredTool(): Tool?
    if not humanoid or humanoid.Health <= 0 then
        return nil
    end

    local tool = findTool()
    if not tool then
        return nil
    end

    if tool.Parent == backpack then
        humanoid:EquipTool(tool)
        task.wait()
    end

    if tool.Parent == character then
        return tool
    end

    return nil
end

local function stopTool()
    toolActivationEnabled = false

    local tool = findTool()
    if tool then
        tool:Deactivate()
    end
end

-- Luồng kích hoạt công cụ riêng
task.spawn(function()
    while scriptRunning do
        if toolActivationEnabled
            and currentState == State.FARMING
            and humanoid
            and humanoid.Health > 0
            and not isBagFull()
        then
            local tool = equipConfiguredTool()

            if tool then
                tool:Activate()
            end
        end

        task.wait(Config.ToolActivationDelay)
    end
end)

--==================================================
-- TWEEN MOVEMENT
--==================================================

local function moveTo(targetPosition: Vector3): boolean
    if not rootPart or not rootPart.Parent then
        return false
    end

    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    local destination = targetPosition + Vector3.new(0, Config.HeightOffset, 0)
    local distance = (rootPart.Position - destination).Magnitude
    local speed = math.max(Config.MovementSpeed, 1)
    local duration = math.max(distance / speed, 0.05)

    if distance <= 2 then
        rootPart.CFrame = CFrame.new(destination)
        return true
    end

    local tweenInfo = TweenInfo.new(
        duration,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )

    activeTween = TweenService:Create(
        rootPart,
        tweenInfo,
        {
            CFrame = CFrame.new(destination),
        }
    )

    local completedState: Enum.PlaybackState? = nil
    local connection = activeTween.Completed:Connect(function(state)
        completedState = state
    end)

    activeTween:Play()

    while scriptRunning
        and activeTween
        and completedState == nil
        and humanoid.Health > 0
    do
        task.wait(0.05)
    end

    connection:Disconnect()
    activeTween = nil

    return completedState == Enum.PlaybackState.Completed
end

--==================================================
-- XỬ LÝ TÚI ĐỒ
--==================================================

local function processBag()
    currentState = State.PROCESSING
    stopTool()

    task.wait(Config.ProcessingTime)

    if scriptRunning and currentValue.Parent then
        -- Chỉ phù hợp khi Current là dữ liệu client-side.
        currentValue.Value = 0
    end
end

--==================================================
-- VÒNG LẶP ĐIỀU KHIỂN TRUNG TÂM
--==================================================

task.spawn(function()
    while scriptRunning do
        if not character
            or not character.Parent
            or not humanoid
            or humanoid.Health <= 0
        then
            currentState = State.IDLE
            stopTool()
            task.wait(1)
            continue
        end

        if isBagFull() then
            if currentState ~= State.MOVING_TO_HIVE
                and currentState ~= State.PROCESSING
            then
                currentState = State.MOVING_TO_HIVE
                stopTool()

                local reachedHive = moveTo(Config.HivePosition)

                if reachedHive and scriptRunning then
                    processBag()
                    currentState = State.IDLE
                end
            end
        else
            if currentState ~= State.MOVING_TO_FIELD
                and currentState ~= State.FARMING
            then
                currentState = State.MOVING_TO_FIELD
                stopTool()

                local reachedField = moveTo(Config.FieldPosition)

                if reachedField and scriptRunning and not isBagFull() then
                    currentState = State.FARMING
                    toolActivationEnabled = true
                else
                    currentState = State.IDLE
                end
            elseif currentState == State.FARMING then
                toolActivationEnabled = true
            end
        end

        task.wait(Config.LoopDelay)
    end
end)
