-- ===== SCRIPT AUTO FARM CHO BSS 1:1 (BẢN THAM KHẢO) =====
-- LƯU Ý: Phải thay đổi tên đối tượng, RemoteEvent phù hợp với game của bạn.
-- KHÔNG ĐẢM BẢO HOẠT ĐỘNG, HÃY DÙNG TÀI KHOẢN PHỤ.

local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- Cấu hình (bạn có thể chỉnh sửa)
local CONFIG = {
    AutoRebirth = true,        -- Tự động Rebirth khi đủ điều kiện
    AutoCollect = true,        -- Tự động thu thập tài nguyên xung quanh
    AutoQuest = true,          -- Tự động nhận/nộp nhiệm vụ
    RebirthWaitTime = 5,       -- Giây chờ giữa các lần Rebirth
    CollectRange = 30,         -- Bán kính tìm vật phẩm
    LoopInterval = 1,          -- Tần suất lặp (giây)
}

-- ===== HÀM TÌM ĐỐI TƯỢNG (CẦN SỬA TÊN CHO ĐÚNG GAME) =====
local function findRebirthButton()
    -- Ví dụ: Tìm nút Rebirth trên màn hình GUI
    for _, screenGui in ipairs(player.PlayerGui:GetChildren()) do
        local btn = screenGui:FindFirstChild("RebirthButton") or screenGui:FindFirstChild("Rebirth")
        if btn and btn:IsA("TextButton") then
            return btn
        end
    end
    return nil
end

local function findCollectibles()
    -- Tìm các vật phẩm có tên chứa "Pollen", "Honey", "Token"
    local items = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Part") or obj:IsA("MeshPart") then
            local name = obj.Name:lower()
            if name:find("pollen") or name:find("honey") or name:find("token") then
                if (obj.Position - rootPart.Position).Magnitude < CONFIG.CollectRange then
                    table.insert(items, obj)
                end
            end
        end
    end
    return items
end

-- ===== HÀM GỬI SỰ KIỆN (REMOTE) – CẦN TÌM ĐÚNG TÊN =====
local function fireRemote(action, ...)
    -- Tìm RemoteEvent trong ReplicatedStorage (thường dùng)
    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("RemoteEvent") 
                  or game:GetService("ReplicatedStorage"):FindFirstChild("GameEvent")
    if remote then
        remote:FireServer(action, ...)
    else
        warn("Không tìm thấy RemoteEvent!")
    end
end

-- ===== TÁC VỤ REBIRTH =====
local function doRebirth()
    if not CONFIG.AutoRebirth then return end
    local btn = findRebirthButton()
    if btn then
        btn:Click()  -- hoặc fireRemote("Rebirth") nếu là Remote
        wait(CONFIG.RebirthWaitTime)
    else
        -- Nếu không có nút, thử gửi Remote với action "Rebirth"
        fireRemote("Rebirth")
    end
end

-- ===== TÁC VỤ THU THẬP =====
local function doCollect()
    if not CONFIG.AutoCollect then return end
    local items = findCollectibles()
    for _, item in ipairs(items) do
        -- Di chuyển đến vị trí item
        rootPart.CFrame = CFrame.new(item.Position)
        wait(0.2)
        -- Giả sử có Remote để thu thập
        fireRemote("Collect", item)
        -- Hoặc click trực tiếp nếu là ClickDetector
        local clickDetector = item:FindFirstChild("ClickDetector")
        if clickDetector then
            clickDetector:Click()
        end
    end
end

-- ===== TÁC VỤ NHẬN/NỘP QUEST =====
local function doQuest()
    if not CONFIG.AutoQuest then return end
    -- Giả sử có NPC hoặc GUI quest, bạn cần tìm và tương tác
    -- Ví dụ: Tìm NPC trong workspace
    for _, npc in ipairs(workspace:GetDescendants()) do
        if npc:IsA("Model") and npc.Name:find("Quest") then
            local humanoidNPC = npc:FindFirstChild("Humanoid")
            if humanoidNPC then
                -- Di chuyển đến NPC
                rootPart.CFrame = CFrame.new(npc.PrimaryPart.Position)
                wait(0.5)
                -- Gửi Remote nhận/nộp
                fireRemote("Quest", "Accept") -- hoặc "Complete"
            end
        end
    end
end

-- ===== VÒNG LẶP CHÍNH =====
while true do
    pcall(function()
        doRebirth()
        doCollect()
        doQuest()
    end)
    wait(CONFIG.LoopInterval)
end
