-- Hàm lấy vị trí cánh đồng theo tên
local function getFieldPosition(fieldName)
    -- CẦN CHỈNH SỬA: Tìm vị trí thực tế của cánh đồng trong Workspace
    -- Ví dụ: Tìm một Part hoặc Model có tên trùng khớp
    local fieldObj = findObject(fieldName, Workspace)
    if fieldObj then
        if fieldObj:IsA("BasePart") then
            return fieldObj.Position
        elseif fieldObj:IsA("Model") then
            local primaryPart = fieldObj.PrimaryPart
            if primaryPart then return primaryPart.Position end
        end
    end
    -- Fallback: vị trí mặc định (0,0,0)
    warn("Không tìm thấy cánh đồng:", fieldName, "- Sử dụng vị trí mặc định")
    return Vector3.new(0, 20, 0)
end

-- Hàm lấy vị trí Hive (Tổ ong) gần nhất
local function getHivePosition()
    -- CẦN CHỈNH SỬA: Tìm vị trí Hive của người chơi
    -- Thường là một khu vực gần spawn
    local playerHive = findObject("Hive", Workspace) -- Có thể là Model chứa các ô tổ
    if playerHive then
        if playerHive:IsA("BasePart") then
            return playerHive.Position
        elseif playerHive:IsA("Model") then
            local primaryPart = playerHive.PrimaryPart
            if primaryPart then return primaryPart.Position end
        end
    end
    warn("Không tìm thấy Hive, sử dụng vị trí spawn")
    return LocalPlayer.RespawnLocation and LocalPlayer.RespawnLocation.Position or Vector3.new(0, 20, 0)
end

-- Hàm lấy danh sách vật phẩm rơi (tokens, ability tokens)
local function getCollectibles()
    local collectibles = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj:GetAttribute("Collectible") == true then
            -- CẦN CHỈNH SỬA: Kiểm tra thuộc tính thực tế của vật phẩm trong game
            table.insert(collectibles, obj)
        elseif obj:IsA("Tool") and obj:FindFirstChild("Handle") then
            -- Có thể là ability tokens
            if obj.Name:lower():find("token") or obj.Name:lower():find("ability") then
                table.insert(collectibles, obj.Handle)
            end
        end
    end
    return collectibles
end

-- Hàm lấy danh sách Token Links
local function getTokenLinks()
    local links = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("token") and obj.Name:lower():find("link") then
            table.insert(links, obj)
        end
    end
    return links
end

-- Hàm kiểm tra phấn hoa đầy
local function isPollenFull()
    local player = getPlayer()
    -- CẦN CHỈNH SỬA: Kiểm tra giá trị phấn hoa hiện tại so với max
    -- Có thể lấy từ Leaderstats hoặc một giá trị trong Player
    local pollen = player:FindFirstChild("Pollen") or player:FindFirstChild("PollenCount")
    local maxPollen = player:FindFirstChild("MaxPollen") or player:FindFirstChild("PollenCapacity")
    if pollen and maxPollen then
        return pollen.Value >= maxPollen.Value
    end
    -- Fallback: kiểm tra qua các thuộc tính khác
    return false
end

-- Hàm convert pollen tại Hive
local function convertPollen()
    local hivePos = getHivePosition()
    tweenTo(hivePos, Settings.TweenSpeed)
    waitFor(1) -- Chờ đến nơi
    -- CẦN CHỈNH SỬA: Kích hoạt hành động convert (ví dụ: nhấn nút, chạm vào pad)
    -- Có thể sử dụng VirtualUser để nhấn phím hoặc click
    jump()
    waitFor(0.5)
end

-- Hàm nhặt vật phẩm (collect)
local function collectItem(itemPart)
    if not itemPart then return end
    local hrp = getHumanoidRootPart()
    local distance = (itemPart.Position - hrp.Position).Magnitude
    if distance < 10 then
        -- Di chuyển đến gần và chạm
        tweenTo(itemPart.Position, Settings.TweenSpeed)
        waitFor(0.2)
        -- Có thể cần fire touch interest
        firetouchinterest(hrp, itemPart, 0) -- 0 = begin touch
        waitFor(0.1)
        firetouchinterest(hrp, itemPart, 1) -- 1 = end touch
    end
end

