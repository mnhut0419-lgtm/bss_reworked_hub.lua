-- [ NOTIFICATION SYSTEM ]
function sendNotification(title, message, duration)
    local notifFrame = Instance.new("Frame")
    notifFrame.Parent = ScreenGui
    notifFrame.Size = UDim2.new(0, 300, 0, 80)
    notifFrame.Position = UDim2.new(1, -310, 0, 10)
    notifFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    notifFrame.BorderSizePixel = 0
    
    local notifTitle = Instance.new("TextLabel")
    notifTitle.Parent = notifFrame
    notifTitle.Size = UDim2.new(1, 0, 0, 30)
    notifTitle.Text = title
    notifTitle.TextColor3 = Color3.fromRGB(255, 200, 0)
    notifTitle.BackgroundTransparency = 1
    notifTitle.Font = Enum.Font.SourceSansBold
    notifTitle.TextSize = 16
    
    local notifMsg = Instance.new("TextLabel")
    notifMsg.Parent = notifFrame
    notifMsg.Size = UDim2.new(1, 0, 0, 40)
    notifMsg.Position = UDim2.new(0, 0, 0, 30)
    notifMsg.Text = message
    notifMsg.TextColor3 = Color3.fromRGB(255, 255, 255)
    notifMsg.BackgroundTransparency = 1
    notifMsg.Font = Enum.Font.SourceSans
    notifMsg.TextSize = 14
    
    -- Animation
    notifFrame.Position = UDim2.new(1, 10, 0, 10)
    local tween = tweenService:Create(notifFrame, TweenInfo.new(0.5), {Position = UDim2.new(1, -310, 0, 10)})
    tween:Play()
    
    task.wait(duration or 3)
    
    local tweenOut = tweenService:Create(notifFrame, TweenInfo.new(0.5), {Position = UDim2.new(1, 10, 0, 10)})
    tweenOut:Play()
    task.wait(0.5)
    notifFrame:Destroy()
end

