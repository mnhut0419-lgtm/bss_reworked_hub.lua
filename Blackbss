-- Teleport Fields
teleFieldsBtn.MouseButton1Click:Connect(function()
    -- Tìm và teleport tới field ngẫu nhiên
    local fields = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():match("field") then
            table.insert(fields, obj)
        end
    end
    
    if #fields > 0 and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local randomField = fields[math.random(1, #fields)]
        player.Character.HumanoidRootPart.CFrame = CFrame.new(randomField.Position + Vector3.new(0, 10, 0))
    end
end)

