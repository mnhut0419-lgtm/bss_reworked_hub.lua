})

local player = game.Players.LocalPlayer
local vim = game:GetService("VirtualInputManager")

_G.AutoFarm = false
_G.AutoClick = false
_G.AutoCollect = false
local selectedField = nil

-- Dropdown chọn Cánh Đồng
MainTab:CreateDropdown({
   Name = "Select Field (Dịch chuyển đến)",
   Options = {"Sunflower Field", "Dandelion Field", "Mushroom Field", "Blue Flower Field", "Clover Field", "Spider Field", "Strawberry Field", "Rose Field", "Pine Tree Forest", "Pumpkin Patch", "Pineapple Patch", "Cactus Field", "Mountain Top Field", "Pepper Patch", "Coconut Field", "Stump Field"},
   CurrentOption = {"Nil"},
   MultipleOptions = false,
   Flag = "FieldDropdown",
   Callback = function(Option)
      selectedField = Option[1]
      pcall(function()
          local char = player.Character
          local root = char and char:FindFirstChild("HumanoidRootPart")
          if root then
              -- Tìm cánh đồng tương ứng trong Workspace
              local fieldPart = workspace:FindFirstChild("FlowerZones") and workspace.FlowerZones:FindFirstChild(selectedField) 
                                or workspace:FindFirstChild(selectedField) 
                                or workspace:FindFirstChild("Fields") and workspace.Fields:FindFirstChild(selectedField)
              
              if fieldPart then
                  root.CFrame = fieldPart.CFrame + Vector3.new(0, 5, 0)
                  Rayfield:Notify({Title = "Thành công", Content = "Đã dịch chuyển đến " .. selectedField, Duration = 3})
              else
                  -- Dự phòng nếu không tìm thấy tên chính xác, dịch chuyển theo tọa độ mẫu hoặc thông báo
                  Rayfield:Notify({Title = "Lỗi", Content = "Không tìm thấy tọa độ cánh đồng này trong Map!", Duration = 3})
              end
          end
      end)
   end,
})

MainTab:CreateToggle({
   Name = "Bật Auto Click (Vung gậy)",
   CurrentValue = false,
   Flag = "ClickToggle",
   Callback = function(Value)
       _G.AutoClick = Value
   end,
})

MainTab:CreateToggle({
   Name = "Bật Tự Động Nhặt Item Rơi",
