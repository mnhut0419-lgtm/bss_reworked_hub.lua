local function getRemote()
    local remoteNames = {"RemoteEvent", "GameEvent", "Collect", "CollectTotem", "Gather", "Claim", "BSSRemote"}
    for _, name in ipairs(remoteNames) do
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild(name)
        if remote then return remote end
        remote = workspace:FindFirstChild(name)
        if remote then return remote end
    end
    return nil
end

local function findAllCollectibles()
    local items = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local pos
            if obj:IsA("Model") and obj.PrimaryPart then
                pos = obj.PrimaryPart.Position
            elseif obj:IsA("BasePart") then
                pos = obj.Position
            end
            if pos then
                local dist = (pos - rootPart.Position).Magnitude
                if dist < CONFIG.CollectRadius then
                    local hasClick = obj:FindFirstChild("ClickDetector") ~= nil
                    local name = obj.Name:lower()
                    local keywords = {"pollen","honey","token","totem","flower","nectar","collect","drop","item"}
                    local match = false
                    for _, kw in ipairs(keywords) do
                        if name:find(kw) then match = true break end
                    end
                    if hasClick or match then
                        table.insert(items, {Object = obj, Position = pos, Distance = dist})
                    end
                end
            end
        end
    end
    table.sort(items, function(a,b) return a.Distance < b.Distance end)
    return items
end

local function interactWithObject(obj)
    local remote = getRemote()
    local success = false

    if remote then
        pcall(function()
            remote:FireServer(obj)
            success = true
        end)
        if not success then
            pcall(function()
                remote:FireServer(obj.Name, obj.Position)
                success = true
            end)
        end
        if not success then
            pcall(function()
                remote:FireServer("Collect", obj)
                success = true
            end)
        end
    end

    if not success then
        local click = obj:FindFirstChild("ClickDetector")
        if click then
            pcall(function()
                click:Click()
                success = true
            end)
        end
    end

    if not success then
        local tool = player.Backpack:FindFirstChild("Collector") or player.Character:FindFirstChild("Collector")
        if tool then
            pcall(function()
                tool:Activate()
                success = true
            end)
        end
    end

    if not success and remote then
        pcall(function()
            remote:FireServer("Collect", obj.Name)
            success = true
        end)
    end

    return success
end

local function moveToPosition(pos)
    if not pos then return end
    local dist = (pos - rootPart.Position).Magnitude
    if dist < 2 then return end
    local tweenInfo = TweenInfo.new(dist / CONFIG.MoveSpeed, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = CFrame.new(pos)})
    tween:Play()
    return tween
end

local lastCollectTime = 0

while true do
    pcall(function()
        if CONFIG.AutoCollect then
            local items = findAllCollectibles()
            if #items > 0 then
                local target = items[1]
                statusLabel.Text = "📦 Đang tới: " .. target.Object.Name
                local dist = target.Distance
                if dist > 3 then
                    moveToPosition(target.Position)
                    wait(math.min(dist / CONFIG.MoveSpeed, 2.5))
                end
                if dist < 8 and (tick() - lastCollectTime) > 0.3 then
                    local ok = interactWithObject(target.Object)
                    if ok then
                        statusLabel.Text = "✅ Đã nhặt: " .. target.Object.Name
                        lastCollectTime = tick()
                        wait(0.2)
                    else
                        statusLabel.Text = "⚠️ Không thể nhặt " .. target.Object.Name
                        wait(0.5)
                    end
                end
            else
                statusLabel.Text = "🔍 Đang tìm vật phẩm..."
                rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.rad(3), 0)
                wait(0.5)
            end
        end
    end)
    wait(CONFIG.LoopDelay)
end
