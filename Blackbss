-- LocalScript: Worker Drone AI - Client State Machine

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

if not RunService:IsClient() then
	error("Worker Drone AI phải được chạy bằng LocalScript phía Client.")
end

local localPlayer = Players.LocalPlayer

--==================================================
-- CẤU HÌNH
--==================================================

local Configuration = {
	-- THAY tọa độ này thành vị trí trung tâm cánh đồng cần thu hoạch.
	FieldPosition = Vector3.new(0, 5, 0),

	-- THAY tọa độ này thành vị trí đứng trước tổ ong.
	HivePosition = Vector3.new(50, 5, 0),

	-- THAY bằng tên chính xác của Tool nằm trong Backpack.
	ToolName = "HarvestTool",

	-- Vận tốc di chuyển nhân vật, tính theo stud/giây.
	MovementSpeed = 32,

	-- Khoảng cách tối đa trước khi nhân vật được đưa lại về cánh đồng.
	FieldRepositionDistance = 6,

	-- Khoảng cách được xem là đã đến đích.
	ArrivalTolerance = 1,

	-- Khoảng nghỉ giữa mỗi lần Tool:Activate().
	ToolActivationInterval = 0.20,

	-- Bán kính quét Collectible quanh nhân vật.
	CollectionRadius = 20,

	-- Vận tốc Tween hạt tài nguyên về phía nhân vật.
	CollectibleTweenSpeed = 65,

	-- Thời gian chờ trước khi quét Collectible lần tiếp theo.
	CollectionScanInterval = 0.15,

	-- Tránh Tween liên tục cùng một Part nếu nó chưa bị xóa.
	CollectibleTweenCooldown = 0.75,

	-- Giới hạn Tween đồng thời nhằm tránh gây giật.
	MaximumConcurrentCollectibleTweens = 12,

	-- Thời gian chờ tại tổ ong.
	ConversionDuration = 5,

	-- Khoảng nghỉ của vòng lặp State Machine.
	MainLoopInterval = 0.15,
}

assert(Configuration.MovementSpeed > 0, "MovementSpeed phải lớn hơn 0.")
assert(Configuration.CollectibleTweenSpeed > 0, "CollectibleTweenSpeed phải lớn hơn 0.")

--==================================================
-- CÁC TRẠNG THÁI
--==================================================

local WorkerState = table.freeze({
	Waiting = "WAITING",
	MovingToField = "MOVING_TO_FIELD",
	Farming = "FARM",
	MovingToHive = "MOVING_TO_HIVE",
	Converting = "CONVERT",
})

local OperatingMode = table.freeze({
	Farm = "FARM",
	Convert = "CONVERT",
})

local currentWorkerState = WorkerState.Waiting
local scriptIsRunning = true

local function changeWorkerState(nextState)
	if currentWorkerState == nextState then
		return
	end

	currentWorkerState = nextState

	if script.Parent then
		script:SetAttribute("WorkerDroneState", nextState)
	end
end

script:SetAttribute("WorkerDroneState", currentWorkerState)

--==================================================
-- ĐỌC DỮ LIỆU LEADERSTATS
-- Hỗ trợ cả NumberValue/IntValue và Attribute.
--==================================================

local function readNumericStat(statName)
	local leaderstats = localPlayer:FindFirstChild("leaderstats")

	if not leaderstats then
		return nil
	end

	local statObject = leaderstats:FindFirstChild(statName)

	if statObject and
		(statObject:IsA("NumberValue") or statObject:IsA("IntValue")) then
		return statObject.Value
	end

	local attributeValue = leaderstats:GetAttribute(statName)

	if typeof(attributeValue) == "number" then
		return attributeValue
	end

	return nil
end

local function determineOperatingMode()
	local pollen = readNumericStat("Pollen")
	local capacity = readNumericStat("Capacity")

	if pollen == nil or capacity == nil or capacity <= 0 then
		return nil, pollen, capacity
	end

	if pollen < capacity then
		return OperatingMode.Farm, pollen, capacity
	end

	return OperatingMode.Convert, pollen, capacity
end

local function currentModeIs(expectedMode)
	local currentMode = determineOperatingMode()
	return currentMode == expectedMode
end

--==================================================
-- LẤY CHARACTER, HUMANOID VÀ ROOT PART
--==================================================

local function getCharacterContext()
	local character = localPlayer.Character

	if not character or not character.Parent then
		return nil, nil, nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or
		not humanoidRootPart or
		not humanoidRootPart:IsA("BasePart") then
		return character, humanoid, nil, nil
	end

	local characterPrimaryPart = character.PrimaryPart or humanoidRootPart

	return character, humanoid, humanoidRootPart, characterPrimaryPart
end

--==================================================
-- HỆ THỐNG TWEEN DI CHUYỂN NHÂN VẬT
--==================================================

local activeMovementTween = nil
local movementRevision = 0

local function cancelActiveMovement()
	movementRevision += 1

	if activeMovementTween then
		pcall(function()
			activeMovementTween:Cancel()
		end)

		activeMovementTween = nil
	end
end

local function tweenCharacterTo(targetPosition, abortCondition)
	local character, humanoid, humanoidRootPart = getCharacterContext()

	if not character or
		not humanoid or
		not humanoidRootPart or
		humanoid.Health <= 0 then
		return false
	end

	cancelActiveMovement()
	local thisMovementRevision = movementRevision

	local distance = (humanoidRootPart.Position - targetPosition).Magnitude
	local rotationOnly = humanoidRootPart.CFrame - humanoidRootPart.Position
	local targetCFrame = CFrame.new(targetPosition) * rotationOnly

	if distance <= Configuration.ArrivalTolerance then
		pcall(function()
			humanoidRootPart.CFrame = targetCFrame
			humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
			humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
		end)

		return true
	end

	local movementDuration = math.max(
		distance / Configuration.MovementSpeed,
		0.05
	)

	local movementTween = TweenService:Create(
		humanoidRootPart,
		TweenInfo.new(
			movementDuration,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		),
		{
			CFrame = targetCFrame,
		}
	)

	activeMovementTween = movementTween

	local originalAutoRotate = humanoid.AutoRotate
	humanoid.AutoRotate = false
	humanoid:Move(Vector3.zero, false)

	pcall(function()
		humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
		humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
	end)

	local movementFinished = false
	local completedPlaybackState = nil

	local completedConnection = movementTween.Completed:Connect(function(playbackState)
		completedPlaybackState = playbackState
		movementFinished = true
	end)

	local playedSuccessfully, playError = pcall(function()
		movementTween:Play()
	end)

	if not playedSuccessfully then
		completedConnection:Disconnect()

		if activeMovementTween == movementTween then
			activeMovementTween = nil
		end

		if humanoid.Parent then
			humanoid.AutoRotate = originalAutoRotate
		end

		warn("Không thể chạy Tween di chuyển:", playError)
		return false
	end

	local movementTimeout = os.clock() + movementDuration + 2

	while scriptIsRunning and not movementFinished do
		local shouldAbort =
			movementRevision ~= thisMovementRevision
			or not humanoidRootPart.Parent
			or humanoid.Health <= 0
			or os.clock() >= movementTimeout

		if not shouldAbort and abortCondition then
			local conditionSucceeded, conditionResult = pcall(abortCondition)

			if not conditionSucceeded or conditionResult == true then
				shouldAbort = true
			end
		end

		if shouldAbort then
			pcall(function()
				movementTween:Cancel()
			end)

			break
		end

		task.wait(0.05)
	end

	if not movementFinished then
		pcall(function()
			movementTween:Cancel()
		end)

		local cancellationTimeout = os.clock() + 0.25

		while not movementFinished and os.clock() < cancellationTimeout do
			task.wait()
		end
	end

	completedConnection:Disconnect()

	if activeMovementTween == movementTween then
		activeMovementTween = nil
	end

	if humanoid.Parent then
		humanoid.AutoRotate = originalAutoRotate
	end

	local movementCompleted =
		movementFinished
		and completedPlaybackState == Enum.PlaybackState.Completed
		and movementRevision == thisMovementRevision

	if movementCompleted and humanoidRootPart.Parent then
		pcall(function()
			humanoidRootPart.CFrame = targetCFrame
			humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
			humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
		end)
	end

	return movementCompleted
end

--==================================================
-- HỆ THỐNG TỰ ĐỘNG TRANG BỊ VÀ KÍCH HOẠT TOOL
--==================================================

local toolSystemEnabled = false
local toolWorkerRevision = 0

local function findConfiguredTool(character)
	if character then
		local equippedTool = character:FindFirstChild(Configuration.ToolName)

		if equippedTool and equippedTool:IsA("Tool") then
			return equippedTool
		end
	end

	local backpack = localPlayer:FindFirstChild("Backpack")

	if backpack then
		local backpackTool = backpack:FindFirstChild(Configuration.ToolName)

		if backpackTool and backpackTool:IsA("Tool") then
			return backpackTool
		end
	end

	return nil
end

local function stopToolSystem()
	toolSystemEnabled = false
	toolWorkerRevision += 1

	local character = localPlayer.Character
	local configuredTool = findConfiguredTool(character)

	if configuredTool then
		pcall(function()
			configuredTool:Deactivate()
		end)

		local backpack = localPlayer:FindFirstChild("Backpack")

		if backpack and character and configuredTool.Parent == character then
			pcall(function()
				configuredTool.Parent = backpack
			end)
		end
	end
end

local function startToolSystem()
	if toolSystemEnabled then
		return
	end

	toolSystemEnabled = true
	toolWorkerRevision += 1

	local thisToolWorkerRevision = toolWorkerRevision

	task.spawn(function()
		while scriptIsRunning
			and toolSystemEnabled
			and toolWorkerRevision == thisToolWorkerRevision do

			local character, humanoid = getCharacterContext()

			if character and humanoid and humanoid.Health > 0 then
				local configuredTool = findConfiguredTool(character)

				if configuredTool then
					if configuredTool.Parent ~= character then
						pcall(function()
							humanoid:EquipTool(configuredTool)
						end)

						task.wait(0.05)
					end

					if configuredTool.Parent == character then
						pcall(function()
							configuredTool:Activate()
						end)
					end
				end
			end

			task.wait(math.max(
				Configuration.ToolActivationInterval,
				0.03
			))
		end
	end)
end

--==================================================
-- HỆ THỐNG QUÉT VÀ TWEEN COLLECTIBLE
--==================================================

local collectorSystemEnabled = false
local collectorWorkerRevision = 0

local activeCollectibleTweens = setmetatable({}, {
	__mode = "k",
})

local collectibleLastTweenTime = setmetatable({}, {
	__mode = "k",
})

local function countActiveCollectibleTweens()
	local activeCount = 0

	for collectiblePart in pairs(activeCollectibleTweens) do
		if collectiblePart.Parent then
			activeCount += 1
		else
			activeCollectibleTweens[collectiblePart] = nil
		end
	end

	return activeCount
end

local function tweenCollectibleToCharacter(
	collectiblePart,
	humanoidRootPart
)
	if activeCollectibleTweens[collectiblePart] then
		return false
	end

	local currentTime = os.clock()
	local previousTweenTime = collectibleLastTweenTime[collectiblePart]

	if previousTweenTime and
		currentTime - previousTweenTime
			< Configuration.CollectibleTweenCooldown then
		return false
	end

	if not collectiblePart.Parent or not humanoidRootPart.Parent then
		return false
	end

	local distance = (
		collectiblePart.Position - humanoidRootPart.Position
	).Magnitude

	if distance > Configuration.CollectionRadius then
		return false
	end

	local tweenDuration = math.max(
		distance / Configuration.CollectibleTweenSpeed,
		0.05
	)

	local collectibleRotation = (
		collectiblePart.CFrame - collectiblePart.Position
	)

	local targetCFrame =
		CFrame.new(humanoidRootPart.Position)
		* collectibleRotation

	local creationSucceeded, collectibleTween = pcall(function()
		return TweenService:Create(
			collectiblePart,
			TweenInfo.new(
				tweenDuration,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				CFrame = targetCFrame,
			}
		)
	end)

	if not creationSucceeded or not collectibleTween then
		return false
	end

	collectibleLastTweenTime[collectiblePart] = currentTime
	activeCollectibleTweens[collectiblePart] = collectibleTween

	task.spawn(function()
		pcall(function()
			collectibleTween:Play()
			collectibleTween.Completed:Wait()
		end)

		if activeCollectibleTweens[collectiblePart]
			== collectibleTween then
			activeCollectibleTweens[collectiblePart] = nil
		end
	end)

	return true
end

local function stopCollectorSystem()
	collectorSystemEnabled = false
	collectorWorkerRevision += 1

	for _, collectibleTween in pairs(activeCollectibleTweens) do
		pcall(function()
			collectibleTween:Cancel()
		end)
	end
end

local function startCollectorSystem()
	if collectorSystemEnabled then
		return
	end

	collectorSystemEnabled = true
	collectorWorkerRevision += 1

	local thisCollectorWorkerRevision = collectorWorkerRevision

	task.spawn(function()
		while scriptIsRunning
			and collectorSystemEnabled
			and collectorWorkerRevision == thisCollectorWorkerRevision do

			local _, humanoid, humanoidRootPart, characterPrimaryPart =
				getCharacterContext()

			if humanoid
				and humanoid.Health > 0
				and humanoidRootPart
				and characterPrimaryPart then

				local collectiblesFolder =
					Workspace:FindFirstChild("Collectibles")

				if collectiblesFolder then
					local availableTweenSlots =
						Configuration.MaximumConcurrentCollectibleTweens
						- countActiveCollectibleTweens()

					if availableTweenSlots > 0 then
						for _, collectiblePart
							in ipairs(collectiblesFolder:GetDescendants()) do

							if not collectorSystemEnabled
								or collectorWorkerRevision
									~= thisCollectorWorkerRevision then
								break
							end

							if collectiblePart:IsA("BasePart")
								and collectiblePart.Parent
								and collectiblePart ~= humanoidRootPart then

								local distanceFromCharacter = (
									collectiblePart.Position
									- characterPrimaryPart.Position
								).Magnitude

								if distanceFromCharacter
									<= Configuration.CollectionRadius then

									local tweenStarted =
										tweenCollectibleToCharacter(
											collectiblePart,
											humanoidRootPart
										)

									if tweenStarted then
										availableTweenSlots -= 1

										if availableTweenSlots <= 0 then
											break
										end
									end
								end
							end
						end
					end
				end
			end

			task.wait(math.max(
				Configuration.CollectionScanInterval,
				0.05
			))
		end
	end)
end

--==================================================
-- XỬ LÝ RESPAWN VÀ DỪNG SCRIPT
--==================================================

localPlayer.CharacterAdded:Connect(function()
	stopToolSystem()
	stopCollectorSystem()
	cancelActiveMovement()
	changeWorkerState(WorkerState.Waiting)
end)

script.Destroying:Connect(function()
	scriptIsRunning = false
	stopToolSystem()
	stopCollectorSystem()
	cancelActiveMovement()
end)

--==================================================
-- VÒNG LẶP STATE MACHINE TRUNG TÂM
--==================================================

local missingStatsWarningDisplayed = false

local function runMainControlLoop()
	while scriptIsRunning do
		local desiredMode = determineOperatingMode()

		if desiredMode == nil then
			if currentWorkerState ~= WorkerState.Waiting then
				stopToolSystem()
				stopCollectorSystem()
				cancelActiveMovement()
				changeWorkerState(WorkerState.Waiting)
			end

			if not missingStatsWarningDisplayed then
				missingStatsWarningDisplayed = true

				warn(
					"Worker Drone đang chờ leaderstats.Pollen "
					.. "và leaderstats.Capacity."
				)
			end

		elseif desiredMode == OperatingMode.Farm then
			missingStatsWarningDisplayed = false

			local _, humanoid, humanoidRootPart =
				getCharacterContext()

			local characterIsAtField =
				humanoid
				and humanoid.Health > 0
				and humanoidRootPart
				and (
					humanoidRootPart.Position
					- Configuration.FieldPosition
				).Magnitude
					<= Configuration.FieldRepositionDistance

			if currentWorkerState ~= WorkerState.Farming
				or not characterIsAtField then

				stopToolSystem()
				stopCollectorSystem()
				changeWorkerState(WorkerState.MovingToField)

				local reachedField = tweenCharacterTo(
					Configuration.FieldPosition,
					function()
						return not currentModeIs(OperatingMode.Farm)
					end
				)

				if reachedField
					and currentModeIs(OperatingMode.Farm) then

					changeWorkerState(WorkerState.Farming)
					startToolSystem()
					startCollectorSystem()
				else
					changeWorkerState(WorkerState.Waiting)
				end
			else
				startToolSystem()
				startCollectorSystem()
			end

		elseif desiredMode == OperatingMode.Convert then
			missingStatsWarningDisplayed = false

			-- Ngừng Tool và Collector ngay khi Capacity đầy.
			stopToolSystem()
			stopCollectorSystem()

			changeWorkerState(WorkerState.MovingToHive)

			local reachedHive = tweenCharacterTo(
				Configuration.HivePosition,
				function()
					return not currentModeIs(OperatingMode.Convert)
				end
			)

			if reachedHive
				and currentModeIs(OperatingMode.Convert) then

				changeWorkerState(WorkerState.Converting)

				local conversionEndTime =
					os.clock() + Configuration.ConversionDuration

				while scriptIsRunning
					and os.clock() < conversionEndTime do

					local remainingTime =
						conversionEndTime - os.clock()

					task.wait(math.min(0.10, remainingTime))
				end
			end

			if scriptIsRunning then
				changeWorkerState(WorkerState.Waiting)
			end
		end

		task.wait(math.max(
			Configuration.MainLoopInterval,
			0.05
		))
	end
end

runMainControlLoop()
