-- Farm Phấn Hoa
farmPollenBtn.MouseButton1Click:Connect(function()
    farmPollen = not farmPollen
end)

task.spawn(function()
    while _G.BSS_Atlas_Running do
        task.wait(0.1)
        if farmPollen then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local root = char.HumanoidRootPart
                
                -- Tìm flowers
                local flowers = {}
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and obj.Name:lower():match("flower") then
                        table.insert(flowers, obj)
                    end
                end
                
                if #flowers > 0 then
                    local target = flowers[math.random(1, #flowers)]
                    if char:FindFirstChild("Humanoid") then
                        char.Humanoid:MoveTo(target.Position)
                        
                        local tool = char:FindFirstChildOfClass("Tool")
                        if not tool then
                            local bpTool = player.Backpack:FindFirstChildOfClass("Tool")
                            if bpTool then
                                char.Humanoid:EquipTool(bpTool)
                            end
                        elseif tool then
                            tool:Activate()
                        end
                    end
                end
            end
        end
    end
end)

-- Thu Thập Token
collectTokensBtn.MouseButton1Click:Connect(function()
    collectTokens = not collectTokens
end)

task.spawn(function()
    while _G.BSS_Atlas_Running do
        task.wait(0.05)
        if collectTokens then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local root = char.HumanoidRootPart
                local nearestToken = nil
                local shortestDist = 100
                
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and obj.Name:lower():match("token") then
                        local dist = (obj.Position - root.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            nearestToken = obj
                        end
                    end
                end
                
                if nearestToken and char:FindFirstChild("Humanoid") then
                    char.Humanoid:MoveTo(nearestToken.Position)
                    if shortestDist < 5 then
                        root.CFrame = CFrame.new(nearestToken.Position)
                    end
                end
            end
        end
    end
end)

-- Farm Boss
farmBossBtn.MouseButton1Click:Connect(function()
    farmBoss = not farmBoss
end)

task.spawn(function()
    while _G.BSS_Atlas_Running do
        task.wait(0.5)
        if farmBoss then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local root = char.HumanoidRootPart
                
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj.Name:lower():match("boss") then
                        local bossRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                        if bossRoot then
                            local dist = (bossRoot.Position - root.Position).Magnitude
                            if dist < 100 then
                                if char:FindFirstChild("Humanoid") then
                                    char.Humanoid:MoveTo(bossRoot.Position)
                                    
                                    local tool = char:FindFirstChildOfClass("Tool")
                                    if tool and dist < 20 then
                                        tool:Activate()
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

