--============================================================
-- TOOL ACTIVATION THREAD
--============================================================

task.spawn(function()
	while alive do
		if autoPlayEnabled
			and toolActivationEnabled
			and currentState == State.FARMING
			and not isBagFull() then
			local tool = equipTool()
			if tool then
				local success, activationError = pcall(function()
					tool:Activate()
				end)

				if not success then
					setStatus("Tool Activate bi loi: " .. tostring(activationError), Colors.Red)
				end
			end
		end

		task.wait(Config.ToolActivationDelay)
	end
end)

-- Hien du lieu tui lien tuc tren menu.
task.spawn(function()
	while alive do
		local current, capacity, dataError = readBag()
		if current ~= nil and capacity ~= nil then
			statsLabel.Text = string.format("Tui: %s / %s", tostring(current), tostring(capacity))
		else
			statsLabel.Text = "Tui: " .. tostring(dataError)
		end
		task.wait(0.25)
	end
end)

--============================================================
-- MAIN CONTROL STATE MACHINE
--============================================================

local function controlCycle()
	if not autoPlayEnabled then
		task.wait(0.20)
		return
	end

	local _, humanoid, root = getRig()
	if not humanoid or not root or humanoid.Health <= 0 then
		stopTool()
		setState(State.WAITING_CHARACTER, "Dang doi Character/HumanoidRootPart...", Colors.Orange)
		task.wait(0.50)
		return
	end

	local current, capacity, dataError = readBag()
	if current == nil or capacity == nil then
		stopTool()
		setState(State.WAITING_DATA, "Loi du lieu: " .. tostring(dataError), Colors.Red)
		task.wait(0.75)
		return
	end

	if capacity <= 0 then
		stopTool()
		setState(State.WAITING_DATA, "Capacity phai lon hon 0", Colors.Red)
		task.wait(0.75)
		return
	end

	if current >= capacity then
		stopTool()

		if (root.Position - Config.HivePosition).Magnitude > Config.ArrivalDistance then
			setState(State.MOVING_TO_HIVE, "Tui day - dang ve Hive...", Colors.Orange)
			if not tweenTo(Config.HivePosition) then
				task.wait(Config.ControlLoopDelay)
				return
			end
		end

		if not autoPlayEnabled then
			return
		end

		setState(State.PROCESSING, "Dang xu ly tai Hive...", Colors.Orange)
		local finishTime = os.clock() + Config.ProcessingTime

		while alive and autoPlayEnabled and os.clock() < finishTime do
			local secondsLeft = math.max(0, math.ceil(finishTime - os.clock()))
			setStatus("Dang xu ly tai Hive: " .. secondsLeft .. " giay", Colors.Orange)
			task.wait(0.20)
		end

		if autoPlayEnabled then
			if writeCurrent(0) then
				setStatus("Da xu ly xong - chuan bi quay lai Field", Colors.Green)
			else
				setStatus("Khong the reset Current", Colors.Red)
			end
		end

		task.wait(Config.ControlLoopDelay)
		return
	end

	if (root.Position - Config.FieldPosition).Magnitude > Config.ArrivalDistance then
		stopTool()
		setState(State.MOVING_TO_FIELD, "Dang di chuyen den Field...", Colors.Blue)
		tweenTo(Config.FieldPosition)
		task.wait(Config.ControlLoopDelay)
		return
	end

	if isBagFull() then
		stopTool()
		task.wait(Config.ControlLoopDelay)
		return
	end

	local tool = findTool()
	if not tool then
		stopTool()
		setState(
			State.WAITING_TOOL,
			"Khong tim thay Tool: " .. Config.ToolName .. " trong Backpack",
			Colors.Red
		)
		task.wait(0.75)
		return
	end

	currentState = State.FARMING
	toolActivationEnabled = true
	setStatus("Dang thu thap tai Field bang " .. tool.Name, Colors.Green)
	task.wait(Config.ControlLoopDelay)
end

task.spawn(function()
	while alive do
		local success, cycleError = xpcall(controlCycle, debug.traceback)
		if not success then
			setAutoPlay(false)
			setStatus("SCRIPT ERROR: " .. tostring(cycleError), Colors.Red)
			warn("[Sandbox AutoPlay] " .. tostring(cycleError))
			task.wait(1)
		end
	end
end)

