local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local isAiming = false
local SMOOTHNESS = 0.5 -- Tăng số này lên (tối đa 1) để camera ghim chặt/nhanh hơn khi bắn
local TARGET_PART = "Head" 

-- 1. HÀM KIỂM TRA XUYÊN TƯỜNG (RAYCASTING)
local function hasLineOfSight(targetCharacter)
    local origin = Camera.CFrame.Position
    local targetPos = targetCharacter[TARGET_PART].Position
    local direction = (targetPos - origin) -- Hướng và khoảng cách từ Camera đến địch
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    -- Bỏ qua bản thân người chơi để tia chiếu không bị chặn bởi chính mình
    if LocalPlayer.Character then
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    end
    
    -- Phóng một tia từ Camera đến vị trí kẻ địch
    local raycastResult = workspace:Raycast(origin, direction, raycastParams)
    
    -- Nếu tia chiếu va chạm vào một vật thể
    if raycastResult then
        -- Kiểm tra xem vật thể bị chạm có phải là một bộ phận của kẻ địch không
        if raycastResult.Instance:IsDescendantOf(targetCharacter) then
            return true -- Nhìn thấy rõ địch, không có tường
        else
            return false -- Tia bị chặn bởi tường hoặc vật cản khác
        end
    end
    
    return true
end

-- 2. HÀM TÌM ĐỊCH GẦN TÂM NHẤT (CÓ LỌC TƯỜNG)
local function getClosestPlayerToCenter()
    local closestCharacter = nil
    local shortestDistance = math.huge
    local viewportCenter = Camera.ViewportSize / 2
    local centerVector2 = Vector2.new(viewportCenter.X, viewportCenter.Y)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character and character:FindFirstChild(TARGET_PART) and character:FindFirstChild("Humanoid") then
                if character.Humanoid.Health > 0 then
                    local targetPart = character[TARGET_PART]
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)

                    if onScreen then
                        -- CHỈ TIẾP TỤC NẾU KẺ ĐỊCH KHÔNG BỊ TƯỜNG CHE
                        if hasLineOfSight(character) then
                            local screenPosVector2 = Vector2.new(screenPos.X, screenPos.Y)
                            local distanceFromCenter = (screenPosVector2 - centerVector2).Magnitude

                            if distanceFromCenter < shortestDistance then
                                shortestDistance = distanceFromCenter
                                closestCharacter = character
                            end
                        end
                    end
                end
            end
        end
    end
    return closestCharacter
end

-- 3. ĐIỀU KHIỂN KHI BẤM NÚT BẮN (TƯƠNG THÍCH MOBILE)
-- Lưu ý: Không dùng 'gameProcessed' để script vẫn nhận diện khi bạn bấm vào nút bắn (UI) trên màn hình
UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isAiming = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isAiming = false
    end
end)

-- 4. GHIM CAMERA MƯỢT MÀ
RunService.RenderStepped:Connect(function()
    if isAiming then
        local targetCharacter = getClosestPlayerToCenter()
        if targetCharacter and targetCharacter:FindFirstChild(TARGET_PART) then
            local targetPosition = targetCharacter[TARGET_PART].Position
            local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPosition)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, SMOOTHNESS)
        end
    end
end)
