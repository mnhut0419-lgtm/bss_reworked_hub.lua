local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- === CÁC TÙY CHỈNH (SETTINGS) ===
local isAiming = false
local SMOOTHNESS = 0.5       -- Tốc độ lia camera (0.1 đến 1)
local TARGET_PART = "Head"   -- Bộ phận ngắm vào
local FOV_RADIUS = 120       -- Bán kính của vòng tròn FOV (Chỉnh to nhỏ tùy ý)
local FOV_COLOR = Color3.fromRGB(255, 0, 0) -- Màu của vòng tròn (Đang là màu đỏ)

-- === 1. TẠO VÒNG TRÒN FOV TRÊN MÀN HÌNH ===
-- Xác định nơi đặt UI (Hỗ trợ cả Roblox Studio lẫn phần mềm chạy Script)
local uiParent = pcall(function() return game:GetService("CoreGui").Name end) and game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")

-- Xóa vòng tròn cũ nếu bạn chạy lại script nhiều lần
if uiParent:FindFirstChild("AimbotFOV_UI") then
    uiParent.AimbotFOV_UI:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AimbotFOV_UI"
screenGui.Parent = uiParent

local fovCircle = Instance.new("Frame")
fovCircle.Size = UDim2.new(0, FOV_RADIUS * 2, 0, FOV_RADIUS * 2)
fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
fovCircle.AnchorPoint = Vector2.new(0.5, 0.5) -- Đưa tâm frame vào giữa màn hình
fovCircle.BackgroundTransparency = 1 -- Làm trong suốt nền
fovCircle.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(1, 0) -- Bo tròn thành hình tròn hoàn hảo
uiCorner.Parent = fovCircle

local uiStroke = Instance.new("UIStroke")
uiStroke.Color = FOV_COLOR
uiStroke.Thickness = 1.5 -- Độ dày viền
uiStroke.Parent = fovCircle

-- === 2. HÀM KIỂM TRA XUYÊN TƯỜNG ===
local function hasLineOfSight(targetCharacter)
    local origin = Camera.CFrame.Position
    local targetPos = targetCharacter[TARGET_PART].Position
    local direction = (targetPos - origin)
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    if LocalPlayer.Character then
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    end
    
    local raycastResult = workspace:Raycast(origin, direction, raycastParams)
    
    if raycastResult then
        if raycastResult.Instance:IsDescendantOf(targetCharacter) then
            return true
        else
            return false
        end
    end
    return true
end

-- === 3. TÌM ĐỊCH TRONG VÒNG TRÒN FOV ===
local function getClosestPlayerInFOV()
    local closestCharacter = nil
    local shortestDistance = math.huge
    local viewportCenter = Camera.ViewportSize / 2
    local centerVector2 = Vector2.new(viewportCenter.X, viewportCenter.Y)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character and character:FindFirstChild(TARGET_PART) and character:FindFirstChild("Humanoid") then
                if character.Humanoid.Health > 0 then
                    local targetPart = character[TARGET_PART]
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)

                    if onScreen then
                        local screenPosVector2 = Vector2.new(screenPos.X, screenPos.Y)
                        local distanceFromCenter = (screenPosVector2 - centerVector2).Magnitude

                        -- ĐIỀU KIỆN MỚI: Kẻ địch phải nằm trong bán kính của vòng tròn FOV
                        if distanceFromCenter <= FOV_RADIUS then
                            -- Tiếp tục kiểm tra xem có bị khuất tường không
                            if hasLineOfSight(character) then
                                if distanceFromCenter < shortestDistance then
                                    shortestDistance = distanceFromCenter
                                    closestCharacter = character
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return closestCharacter
end

-- === 4. BẬT/TẮT KHI BẤM NÚT BẮN ===
UserInputService.InputBegan:Connect(function(input)
    -- Nhận diện chạm màn hình (mobile) hoặc click chuột trái
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isAiming = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isAiming = false
    end
end)

-- === 5. CHẠY AIMBOT MỖI KHUNG HÌNH ===
RunService.RenderStepped:Connect(function()
    if isAiming then
        local targetCharacter = getClosestPlayerInFOV()
        if targetCharacter and targetCharacter:FindFirstChild(TARGET_PART) then
            local targetPosition = targetCharacter[TARGET_PART].Position
            local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPosition)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, SMOOTHNESS)
        end
    end
end)
